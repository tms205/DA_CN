<MudThemeProvider Theme="Theme.PhotocopyChain" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    @if (context.User.Identity?.IsAuthenticated == true)
                    {
                        <div class="trang-thong-bao">
                            <h1>Không có quyền truy cập</h1>
                            <p>Vai trò của bạn không được dùng chức năng này.</p>
                            <a href="">Về trang chủ</a>
                        </div>
                    }
                    else
                    {
                        <ChuyenDenDangNhap />
                    }
                </NotAuthorized>
                <Authorizing>
                    <div class="trang-thong-bao"><p>Đang kiểm tra phiên đăng nhập…</p></div>
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>Không tìm thấy trang</PageTitle>
            <LayoutView Layout="@typeof(TrongLayout)">
                <div class="trang-thong-bao">
                    <h1>Không tìm thấy trang</h1>
                    <a href="">Về trang chủ</a>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
