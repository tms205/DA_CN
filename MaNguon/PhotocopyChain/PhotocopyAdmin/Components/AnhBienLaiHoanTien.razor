@inject HttpClient Http
@if (BienLai != null) {
    <div style="margin-top:12px">
        <p><b>Biên lai hoàn tiền</b> · @BienLai.Luc.ToOffset(TimeSpan.FromHours(7)).ToString("HH:mm dd/MM/yyyy")</p>
        <p>Mã chuyển tiền: <b class="mono">@BienLai.MaChuyenKhoan</b></p>
        @if (!string.IsNullOrWhiteSpace(BienLai.LyDo)) { <p style="white-space:pre-wrap"><b>Lời nhắn cho khách:</b> @BienLai.LyDo</p> }
        <button type="button" class="nut-phu" @onclick="Xem" disabled="@_tai">@(_tai?"Đang tải…":"Xem biên lai chuyển khoản")</button>
        @if (_loi != null) { <p role="alert">@_loi</p> }
        @if (_anh != null) { <img src="@_anh" alt="Biên lai chuyển khoản hoàn tiền của CEO" style="display:block;max-width:100%;max-height:65vh;object-fit:contain;margin:12px auto" /> }
    </div>
}
@code {
    [Parameter] public int MaDonHang { get; set; }
    [Parameter] public BienLaiHoanTienDto BienLai { get; set; }
    private string _anh, _loi; private bool _tai;
    private async Task Xem() {
        if (_tai) return; _tai=true;_loi=null;
        try { using var r=await Http.GetAsync($"api/don-hang/{MaDonHang}/bien-lai-hoan-tien/{BienLai.Anh.MaAnh}");
            r.EnsureSuccessStatusCode(); var mime=r.Content.Headers.ContentType?.MediaType;var data=await r.Content.ReadAsByteArrayAsync();
            if(mime is not("image/jpeg" or "image/png") || data.Length>5*1024*1024)throw new InvalidDataException();
            _anh=$"data:{mime};base64,{Convert.ToBase64String(data)}";
        } catch { _loi="Không tải được biên lai. Hãy thử lại."; }
        finally { _tai=false; }
    }
}
