@using System.Globalization
@* Adapted interaction pattern: Lucian UX/UI #095 (MIT); see docs/THIRD_PARTY_LUCIAN_UXUI.md. *@
<div class="tq-bieu-do cd-xu-huong">
    <div class="cd-dau">
        <div class="cd-so-lieu" aria-live="polite">
            <span>@(ChiSo >= 0 ? TenKy(HienTai[ChiSo].Ngay) : "Tổng doanh thu trong kỳ")</span>
            <strong>@TongQuanBaoCao.Tien(ChiSo >= 0 ? HienTai[ChiSo].DoanhThu : HienTai.Sum(x => x.DoanhThu))</strong>
        </div>
        @if (NhomTheoChanged.HasDelegate)
        {
            <div class="cd-nhom" role="group" aria-label="Nhóm báo cáo">
                @foreach (string nhom in new[] { "ngay", "tuan", "thang" })
                {
                    <button type="button" aria-pressed="@(NhomTheo == nhom ? "true" : "false")" @onclick="() => NhomTheoChanged.InvokeAsync(nhom)">@(nhom == "ngay" ? "Ngày" : nhom == "tuan" ? "Tuần" : "Tháng")</button>
                }
            </div>
        }
    </div>
    @if (HienTai.Count > 0)
    {
        <div class="cd-bieu-do" style="@($"--khoang-cot:{(HienTai.Count > 60 ? 0 : HienTai.Count > 31 ? 2 : 4)}px")">
            <div class="cd-truc" aria-hidden="true">
                @for (int i = 4; i >= 0; i--) { <span>@TongQuanBaoCao.Tien(_buoc * i)</span> }
            </div>
            <div class="cd-plot">
                <div class="cd-luoi" aria-hidden="true">@for (int i = 0; i < 5; i++) { <span></span> }</div>
                <div class="cd-trung-binh" style="@($"bottom:{So(ChieuCao(_trungBinh))}%")" aria-hidden="true"><span>TB @TongQuanBaoCao.Tien(_trungBinh)</span></div>
                <div class="cd-cac-cot @(ChiSo >= 0 ? "co-chon" : "")" role="group" aria-label="Doanh thu theo từng kỳ">
                    @for (int i = 0; i < HienTai.Count; i++)
                    {
                        int index = i;
                        var diem = HienTai[index];
                        <button @key="index" @ref="_cacCot[index]" type="button" class="cd-cot @(ChiSo == index ? "dang-chon" : "") @(_ghim == index ? "ghim" : "") @(index == HienTai.Count - 1 ? "cot-cuoi" : "")"
                            style="@($"--cao:{So(ChieuCao(diem.DoanhThu))}%")" data-gia-tri="@diem.DoanhThu.ToString(CultureInfo.InvariantCulture)"
                            tabindex="@(index == _focus ? 0 : -1)" aria-pressed="@(_ghim == index ? "true" : "false")"
                            aria-label="@(TenKy(diem.Ngay) + ": " + TongQuanBaoCao.Tien(diem.DoanhThu))"
                            @onmouseenter="() => _di = index" @onmouseleave="() => _di = -1" @onfocus="() => _di = index" @onblur="() => _di = -1"
                            @onclick="() => Ghim(index)" @onkeydown="e => PhimCot(e, index)"><i aria-hidden="true"></i></button>
                    }
                </div>
                @if (ChiSo >= 0)
                {
                    var diem = HienTai[ChiSo];
                    <div class="cd-tooltip" role="status"><b>@TenKy(diem.Ngay)</b><span>@TongQuanBaoCao.Tien(diem.DoanhThu) · @diem.SoDon đơn</span>
                    @if (ChiSo < KyTruoc.Count && KyTruoc[ChiSo].DoanhThu != 0) { <small>Kỳ trước: @TongQuanBaoCao.Tien(KyTruoc[ChiSo].DoanhThu)</small> }
                    @if (_ghim >= 0) { <small>Đã ghim · bấm lại hoặc nhấn Esc để bỏ ghim</small> }</div>
                }
            </div>
            <div class="cd-truc-ngang" aria-hidden="true">
                @for (int i = 0; i < HienTai.Count; i++)
                {
                    if (i == 0 || i == HienTai.Count - 1 || i % Math.Max(1, (HienTai.Count + 3) / 4) == 0)
                    { <span style="@($"left:{So((i + .5) / HienTai.Count * 100)}%;transform:translateX({(i == 0 ? "0" : i == HienTai.Count - 1 ? "-100%" : "-50%")})")">@HienTai[i].Ngay.ToString(NhomTheo == "thang" ? "MM/yyyy" : "dd/MM")</span> }
                }
            </div>
        </div>
        <p class="cd-huong-dan">Rê chuột hoặc chọn một cột để xem chi tiết · dùng phím ← / → để chuyển cột.</p>
    }
    else { <p class="cd-rong">Chưa có dữ liệu doanh thu trong kỳ.</p> }
</div>

@code {
    [Parameter] public List<BaoCaoDoanhThuDto> HienTai { get; set; } = new();
    [Parameter] public List<BaoCaoDoanhThuDto> KyTruoc { get; set; } = new();
    [Parameter] public string NhomTheo { get; set; } = "ngay";
    [Parameter] public EventCallback<string> NhomTheoChanged { get; set; }
    private decimal _buoc, _trungBinh;
    private int _di = -1, _ghim = -1, _focus;
    private ElementReference[] _cacCot = Array.Empty<ElementReference>();
    private List<BaoCaoDoanhThuDto> _cu;
    private int ChiSo => _di >= 0 && _di < HienTai.Count ? _di : _ghim >= 0 && _ghim < HienTai.Count ? _ghim : -1;

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_cu, HienTai)) { _di = _ghim = -1; _focus = 0; _cu = HienTai; }
        if (_cacCot.Length != HienTai.Count) _cacCot = new ElementReference[HienTai.Count];
        _buoc = TongQuanBaoCao.BuocTruc(HienTai.Select(x => x.DoanhThu).DefaultIfEmpty(0).Max());
        _trungBinh = HienTai.Count == 0 ? 0 : HienTai.Average(x => x.DoanhThu);
    }
    private void Ghim(int index) { _ghim = _ghim == index ? -1 : index; _focus = index; }
    private async Task PhimCot(KeyboardEventArgs e, int index)
    {
        if (e.Key == "Escape") { _di = _ghim = -1; return; }
        if (e.Key is not ("ArrowLeft" or "ArrowRight") || HienTai.Count == 0) return;
        _focus = (index + (e.Key == "ArrowRight" ? 1 : HienTai.Count - 1)) % HienTai.Count;
        _di = _focus;
        await _cacCot[_focus].FocusAsync();
    }
    private double ChieuCao(decimal giaTri) => Math.Clamp((double)(giaTri / (_buoc * 4)) * 100, 0, 100);
    private static string So(double n) => n.ToString("0.###", CultureInfo.InvariantCulture);
    private string TenKy(DateTime ngay) => NhomTheo == "thang" ? ngay.ToString("MM/yyyy") : NhomTheo == "tuan" ? "Tuần từ " + ngay.ToString("dd/MM/yyyy") : ngay.ToString("dd/MM/yyyy");
}
