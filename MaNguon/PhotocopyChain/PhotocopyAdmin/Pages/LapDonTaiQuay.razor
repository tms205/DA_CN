@page "/lap-don-tai-quay"
@attribute [Authorize(Roles = "SUPER_ADMIN,BRANCH_ADMIN,STAFF")]
@inject HttpClient Http
@inject PhienDangNhap Phien
@inject PhamViChiNhanh PhamVi
@using PhotocopyShared.QuyCachIn

<PageTitle>Lập đơn tại quầy · PhotocopyChain</PageTitle>
<TieuDeTrang TieuDe="Lập đơn tại quầy" MoTa="Khách chọn quét QR payOS hoặc COD · thanh toán khi nhận tài liệu" />

<div class="than-trang khoi-doc">
    @if (_loi != null) { <div class="o-loi"><span>@_loi</span></div> }
    @if (_thongBao != null) { <div class="o-thanh-cong the-rong"><span>@_thongBao</span></div> }

    @if (_thanhToanVuaLap != null && _thanhToanVuaLap.PhuongThuc == "VIETQR")
    {
        <div class="the the-rong">
            <h2 class="the-tieu-de nho">Thanh toán payOS cho @_thanhToanVuaLap.MaDonHangHienThi</h2>
            <dl class="bang-thong-tin gon">
                <dt>Số tiền</dt><dd class="mono hd-tong">@Tien(_thanhToanVuaLap.SoTien)</dd>
                <dt>Trạng thái</dt><dd><span class="nhan-mau @(_thanhToanVuaLap.TrangThai == "DA_THANH_TOAN" ? "nhan-xanh" : "nhan-cam")">@(_thanhToanVuaLap.TrangThai == "DA_THANH_TOAN" ? "Đã thanh toán" : "Chờ chuyển khoản")</span></dd>
                @if (_lienKetPayOS != null)
                {
                    <dt>Hạn thanh toán</dt><dd>@_lienKetPayOS.HanThanhToan.ToString("dd/MM/yyyy HH:mm")</dd>
                }
            </dl>
            <div class="xac-nhan-o">
                <button class="nut-nho" @onclick="TaiLaiThanhToanAsync">Kiểm tra thanh toán</button>
                @if (_thanhToanVuaLap.TrangThai == "DA_THANH_TOAN")
                {
                    <a class="nut-nho chinh" href="/?maDonHang=@_thanhToanVuaLap.MaDonHang&thanhToan=thanh-cong">Xem đơn trong hàng đợi</a>
                }
                @if (_thanhToanVuaLap.TrangThai != "DA_THANH_TOAN" && _lienKetPayOS != null)
                {
                    <a class="nut-nho chinh" href="@_lienKetPayOS.CheckoutUrl" target="_blank" rel="noopener noreferrer">Mở mã QR payOS</a>
                }
                else if (_thanhToanVuaLap.TrangThai != "DA_THANH_TOAN")
                {
                    <button class="nut-nho chinh" disabled="@_dangGui" @onclick="TaoLienKetPayOSAsync">Tạo lại mã QR payOS</button>
                }
            </div>
        </div>
    }

    <div class="luoi-hai-cot">
        <div class="the">
            <h2 class="the-tieu-de nho">1. Khách hàng</h2>
            <div class="truong">
                <label class="nhan">Họ tên</label>
                <div class="o-nhap"><input @bind="_hoTen" placeholder="Nguyễn Văn An" /></div>
            </div>
            <div class="truong">
                <label class="nhan">Số điện thoại</label>
                <div class="o-nhap"><input @bind="_soDienThoai" placeholder="09xxxxxxxx" /></div>
            </div>
            <button class="nut-chinh" disabled="@_dangGui" @onclick="ChonKhachAsync">Tìm / tạo khách hàng</button>

            @if (_khach != null)
            {
                <div class="o-thanh-cong"><span>@_khach.HoTen · @_khach.SoDienThoai @(_khach.VuaTao ? "· vừa tạo" : "· đã có tài khoản")</span></div>
            }
        </div>

        <div class="the">
            <h2 class="the-tieu-de nho">2. Tài liệu</h2>
            @if (_khach == null)
            {
                <p class="the-mo-ta nho">Chọn khách hàng trước khi tải file.</p>
            }
            else
            {
                <InputFile OnChange="TaiFileAsync" multiple />
                @if (_dangTaiFile) { <p class="the-mo-ta nho">Đang chuẩn hóa PDF và đếm trang…</p> }
                @foreach (FileInDto file in _dsFile)
                {
                    <div class="hd-dong-in">
                        <b>@file.TenFileGoc</b>
                        <span class="nv-phu">@file.SoTrang trang · đã chuẩn hóa PDF</span>
                        <button class="nut-nho nguy-hiem" disabled="@_dangTaiFile" @onclick="() => XoaFileAsync(file)">Xóa</button>
                    </div>
                }
            }
        </div>
    </div>

    @if (_khach != null && _dsFile.Count > 0)
    {
        <div class="the the-rong">
            <h2 class="the-tieu-de nho">3. Quy cách và báo giá</h2>
            <div class="ca-loc-luoi">
                <div class="truong">
                    <label class="nhan">Khổ giấy & loại giấy</label>
                    <select class="ca-o-loc" value="@_khoaGiay" @onchange="DoiKhoGiay">
                        @foreach (DichVuDto dv in DsKhoGiay())
                        {
                            <option value="@KhoaGiay(dv)">@dv.KhoGiay @dv.LoaiGiay</option>
                        }
                    </select>
                </div>
                <div class="truong">
                    <label class="nhan">Mặt in</label>
                    <select class="ca-o-loc" value="@_matIn" @onchange="DoiMatIn">
                        @foreach (string mat in DsMatIn())
                        {
                            <option value="@mat">@(mat == "2_MAT" ? "In 2 mặt" : "In 1 mặt")</option>
                        }
                    </select>
                </div>
                <div class="truong">
                    <label class="nhan">Hướng giấy</label>
                    <select class="ca-o-loc" @bind="_huongGiay" @bind:after="XoaBaoGia">
                        <option value="DUNG">Giấy đứng</option>
                        <option value="NGANG">Giấy ngang</option>
                    </select>
                </div>
                <div class="truong">
                    <label class="nhan">Màu sắc</label>
                    <select class="ca-o-loc" value="@_mauSac" @onchange="DoiMauSac">
                        @foreach (string mau in DsMauSac())
                        {
                            <option value="@mau">@(mau == "MAU" ? "In màu" : "Đen trắng")</option>
                        }
                    </select>
                </div>
                <div class="truong">
                    <label class="nhan">Số bản mỗi file</label>
                    <input class="ca-o-loc" type="number" min="1" @bind="_soBan" />
                </div>
                <label class="hop-chon"><input type="checkbox" @bind="_inGap" /><span class="o-vuong">✓</span>In hỏa tốc (+10.000₫)</label>
                <div class="truong">
                    <label class="nhan">Mã khuyến mãi</label>
                    <input class="ca-o-loc mono" @bind="_maCode" />
                </div>
                <div class="truong">
                    <label class="nhan">Thanh toán</label>
                    <select class="ca-o-loc" @bind="_phuongThucThanhToan">
                        <option value="VIETQR">Quét QR payOS tại quầy</option>
                        <option value="COD">COD · trả khi nhận tài liệu</option>
                    </select>
                </div>
            </div>

            <h3 class="hd-muc">Gia công</h3>
            <div class="thanh-loc">
                @foreach (DichVuDto dv in _dsDichVu.Where(x => x.LoaiDichVu == "GIA_CONG"))
                {
                    <label class="hop-chon">
                        <input type="checkbox" checked="@_dsGiaCong.Contains(dv.MaDichVu)" disabled="@(QuyTacIn.LaKimGoc(dv.TenDichVu) && !KimGocHopLe())" @onchange="e => DoiGiaCong(dv, (bool)e.Value)" />
                        <span class="o-vuong">✓</span>@dv.TenDichVu · @Tien(dv.DonGia)/bản
                    </label>
                }
            </div>
            <p class="nv-phu">Kim góc: tối đa 50 tờ giấy mỗi file, mỗi bản. Lò xo không chọn cùng kim góc; ép plastic vẫn chọn cùng lò xo.</p>
            @if (!KimGocHopLe())
            {
                <div class="o-canh-bao">Có file vượt 50 tờ/bản theo mặt in hiện tại, không thể chọn bấm kim góc.</div>
            }
            @if (_thongBaoGiaCong != null)
            {
                <div class="o-canh-bao"><span>@_thongBaoGiaCong</span></div>
            }

            <div class="truong">
                <label class="nhan">Ghi chú cho thợ in</label>
                <div class="o-nhap"><input @bind="_ghiChu" placeholder="Ví dụ: bấm kim góc trái" /></div>
            </div>

            @if (_baoGia != null)
            {
                <dl class="bang-thong-tin gon">
                    <dt>Tiền in</dt><dd class="mono">@Tien(_baoGia.TienIn)</dd>
                    <dt>Gia công</dt><dd class="mono">@Tien(_baoGia.TienGiaCong)</dd>
                    @foreach (DichVuDto giaCong in DsGiaCongDaChon())
                    {
                        decimal thanhTienGiaCong = giaCong.DonGia * _soBan * _dsFile.Count;
                        <dt class="nv-phu">↳ @giaCong.TenDichVu (@Tien(giaCong.DonGia) × @_soBan bản × @_dsFile.Count file)</dt>
                        <dd class="mono nv-phu">@Tien(thanhTienGiaCong)</dd>
                    }
                    <dt>Phụ phí hỏa tốc</dt><dd class="mono">@Tien(_baoGia.PhuPhiGap)</dd>
                    <dt>Giảm giá</dt><dd class="mono">−@Tien(_baoGia.GiamGia)</dd>
                    <dt>@(_phuongThucThanhToan == "VIETQR" ? "Tổng thanh toán" : "Tổng thu khi giao")</dt><dd class="mono hd-tong">@Tien(_baoGia.TongTien)</dd>
                </dl>
                @if (_baoGia.KhuyenMaiHopLe == false) { <div class="o-canh-bao"><span>@_baoGia.LyDoKhuyenMai</span></div> }
            }

            <div class="xac-nhan-o">
                <button class="nut-nho" disabled="@_dangGui" @onclick="BaoGiaAsync">Tính lại giá</button>
                <button class="nut-nho chinh" disabled="@(_dangGui || _baoGia == null)" @onclick="LapDonAsync">@(_phuongThucThanhToan == "VIETQR" ? "Lập đơn & hiện mã QR" : "Lập đơn COD")</button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "maDonHang")]
    public int? MaDonHangTuPayOS { get; set; }

    private string _hoTen = "";
    private string _soDienThoai = "";
    private KhachTaiQuayDto _khach;
    private List<FileInDto> _dsFile = new();
    private string _huongGiay = "DUNG";
    private List<DichVuDto> _dsDichVu = new();
    private List<int> _dsGiaCong = new();
    private int _maDichVu;
    private string _khoaGiay = "";
    private string _matIn = "";
    private string _mauSac = "";
    private int _soBan = 1;
    private bool _inGap;
    private string _maCode = "";
    private string _ghiChu = "";
    private string _phuongThucThanhToan = "VIETQR";
    private BaoGiaResponse _baoGia;
    private ThanhToanDto _thanhToanVuaLap;
    private LienKetPayOSDto _lienKetPayOS;
    private int? _maDonVuaLap;
    private bool _dangGui;
    private bool _dangTaiFile;
    private string _loi;
    private string _thongBao;
    private string _thongBaoGiaCong;

    protected override async Task OnInitializedAsync()
    {
        if (MaDonHangTuPayOS != null)
        {
            _maDonVuaLap = MaDonHangTuPayOS;
            await TaiLaiThanhToanAsync();
            if (_thanhToanVuaLap?.TrangThai == "DA_THANH_TOAN")
                _thongBao = "Đã nhận thanh toán cho " + _thanhToanVuaLap.MaDonHangHienThi + ".";
        }

        try
        {
            int maChiNhanh = PhamVi.MaChiNhanh ?? Phien.NguoiDung?.MaChiNhanh ?? 0;
            if (maChiNhanh <= 0)
            {
                _loi = "Hãy chọn một chi nhánh để tiếp tục lập đơn tại quầy.";
                return;
            }

            _dsDichVu = await Http.GetFromJsonAsync<List<DichVuDto>>("api/danh-muc/bang-gia?maChiNhanh=" + maChiNhanh) ?? new();
            DichVuDto dau = _dsDichVu.FirstOrDefault(x => x.LoaiDichVu == "IN_AN");
            if (dau != null) ApDungDichVu(dau);
        }
        catch { _loi = "Không tải được bảng giá."; }
    }

    private string KhoaGiay(DichVuDto dichVu) => (dichVu.KhoGiay ?? "") + "|" + (dichVu.LoaiGiay ?? "");

    private List<DichVuDto> DsKhoGiay()
    {
        return _dsDichVu.Where(x => x.LoaiDichVu == "IN_AN")
            .GroupBy(KhoaGiay).Select(x => x.First()).ToList();
    }

    private List<string> DsMatIn()
    {
        return _dsDichVu.Where(x => x.LoaiDichVu == "IN_AN" && KhoaGiay(x) == _khoaGiay)
            .Select(x => x.MatIn).Where(x => x != null).Distinct().ToList();
    }

    private List<string> DsMauSac()
    {
        return _dsDichVu.Where(x => x.LoaiDichVu == "IN_AN" && KhoaGiay(x) == _khoaGiay && x.MatIn == _matIn)
            .Select(x => x.MauSac).Where(x => x != null).Distinct().ToList();
    }

    private void ApDungDichVu(DichVuDto dichVu)
    {
        _maDichVu = dichVu.MaDichVu;
        _khoaGiay = KhoaGiay(dichVu);
        _matIn = dichVu.MatIn ?? "";
        _mauSac = dichVu.MauSac ?? "";
        KiemTraKimGoc();
        _baoGia = null;
    }

    private void DoiKhoGiay(ChangeEventArgs e)
    {
        _khoaGiay = e.Value?.ToString() ?? "";
        List<DichVuDto> ds = _dsDichVu.Where(x => x.LoaiDichVu == "IN_AN" && KhoaGiay(x) == _khoaGiay).ToList();
        DichVuDto chon = ds.FirstOrDefault(x => x.MatIn == _matIn && x.MauSac == _mauSac) ?? ds.FirstOrDefault();
        if (chon != null) ApDungDichVu(chon);
    }

    private void DoiMatIn(ChangeEventArgs e)
    {
        _matIn = e.Value?.ToString() ?? "";
        List<DichVuDto> ds = _dsDichVu.Where(x => x.LoaiDichVu == "IN_AN" && KhoaGiay(x) == _khoaGiay && x.MatIn == _matIn).ToList();
        DichVuDto chon = ds.FirstOrDefault(x => x.MauSac == _mauSac) ?? ds.FirstOrDefault();
        if (chon != null) ApDungDichVu(chon);
    }

    private void DoiMauSac(ChangeEventArgs e)
    {
        _mauSac = e.Value?.ToString() ?? "";
        DichVuDto chon = _dsDichVu.FirstOrDefault(x => x.LoaiDichVu == "IN_AN" && KhoaGiay(x) == _khoaGiay &&
            x.MatIn == _matIn && x.MauSac == _mauSac);
        if (chon != null) ApDungDichVu(chon);
    }

    private List<DichVuDto> DsGiaCongDaChon()
    {
        return _dsDichVu.Where(x => _dsGiaCong.Contains(x.MaDichVu)).ToList();
    }

    private async Task ChonKhachAsync()
    {
        _dangGui = true; _loi = null; _thongBao = null;
        try
        {
            var res = await Http.PostAsJsonAsync("api/don-hang/khach-tai-quay", new KhachTaiQuayRequest { HoTen = _hoTen, SoDienThoai = _soDienThoai });
            if (res.IsSuccessStatusCode)
            {
                await XoaTatCaFileDangChonAsync();
                _khach = await res.Content.ReadFromJsonAsync<KhachTaiQuayDto>();
                _dsFile.Clear(); _baoGia = null; _thanhToanVuaLap = null; _lienKetPayOS = null; _maDonVuaLap = null;
            }
            else _loi = (await res.Content.ReadFromJsonAsync<ApiError>()).Message;
        }
        catch { _loi = "Không kết nối được máy chủ API."; }
        _dangGui = false;
    }

    private async Task TaiFileAsync(InputFileChangeEventArgs e)
    {
        if (_khach == null) return;
        _dangTaiFile = true; _loi = null;
        foreach (IBrowserFile file in e.GetMultipleFiles(10))
        {
            try
            {
                using var form = new MultipartFormDataContent();
                using var stream = file.OpenReadStream(60 * 1024 * 1024);
                using var noiDung = new StreamContent(stream);
                form.Add(noiDung, "file", file.Name);
                var res = await Http.PostAsync("api/file-in?maKhachHang=" + _khach.MaKhachHang, form);
                if (res.IsSuccessStatusCode) _dsFile.Add(await res.Content.ReadFromJsonAsync<FileInDto>());
                else _loi = (await res.Content.ReadFromJsonAsync<ApiError>()).Message;
            }
            catch { _loi = "Không tải được file " + file.Name + "."; }
        }
        _dangTaiFile = false;
        KiemTraKimGoc();
        if (_dsFile.Count > 0) await BaoGiaAsync();
    }

    private async Task XoaFileAsync(FileInDto file)
    {
        if (_khach == null) return;
        _loi = null;
        var res = await Http.DeleteAsync("api/file-in/" + file.MaFileIn + "?maKhachHang=" + _khach.MaKhachHang);
        if (res.IsSuccessStatusCode)
        {
            _dsFile.Remove(file);
            _baoGia = null;
        }
        else _loi = (await res.Content.ReadFromJsonAsync<ApiError>()).Message;
    }

    private async Task XoaTatCaFileDangChonAsync()
    {
        if (_khach == null) return;
        foreach (FileInDto file in _dsFile.ToList())
            await Http.DeleteAsync("api/file-in/" + file.MaFileIn + "?maKhachHang=" + _khach.MaKhachHang);
    }

    // Giống App mobile: chọn được nhiều gia công, riêng các dịch vụ cùng nhóm
    // (DONG_GAY: bìa kiếng / lò xo) loại trừ nhau.
    private void DoiGiaCong(DichVuDto dichVu, bool chon)
    {
        _thongBaoGiaCong = null;
        if (!chon)
        {
            _dsGiaCong.Remove(dichVu.MaDichVu);
            _baoGia = null;
            return;
        }

        if (QuyTacIn.LaKimGoc(dichVu.TenDichVu) && !KimGocHopLe())
        {
            _thongBaoGiaCong = "Kim góc chỉ áp dụng tối đa 50 tờ giấy mỗi bản.";
            return;
        }

        List<DichVuDto> dsBiBo = DsGiaCongDaChon().Where(x => x.MaDichVu != dichVu.MaDichVu &&
            QuyTacIn.LoaiTruNhau(x.TenDichVu, x.NhomGiaCong, dichVu.TenDichVu, dichVu.NhomGiaCong)).ToList();
        foreach (DichVuDto biBo in dsBiBo) _dsGiaCong.Remove(biBo.MaDichVu);
        if (dsBiBo.Count > 0)
            _thongBaoGiaCong = "Gia công không thể chọn cùng nhau — đã bỏ \"" +
                string.Join("\", \"", dsBiBo.Select(x => x.TenDichVu)) + "\".";

        if (!_dsGiaCong.Contains(dichVu.MaDichVu)) _dsGiaCong.Add(dichVu.MaDichVu);
        _baoGia = null;
    }

    private List<DongInRequest> TaoDongIn()
    {
        var ds = new List<DongInRequest>();
        foreach (FileInDto file in _dsFile)
            ds.Add(new DongInRequest { MaFileIn = file.MaFileIn, MaDichVu = _maDichVu, SoBanIn = _soBan, HuongGiay = _huongGiay, DsGiaCong = new List<int>(_dsGiaCong) });
        return ds;
    }

    private void XoaBaoGia() => _baoGia = null;

    private bool KimGocHopLe() => _dsFile.All(x => x.SoTrang > 0 &&
        QuyTacIn.SoToMoiBan(x.SoTrang.Value, _matIn) <= QuyTacIn.SoToKimGocToiDa);

    private void KiemTraKimGoc()
    {
        if (KimGocHopLe()) return;
        foreach (DichVuDto dv in DsGiaCongDaChon().Where(x => QuyTacIn.LaKimGoc(x.TenDichVu)))
        {
            _dsGiaCong.Remove(dv.MaDichVu);
            _thongBaoGiaCong = "Đã bỏ bấm kim góc vì có file vượt 50 tờ giấy mỗi bản.";
        }
    }

    private async Task BaoGiaAsync()
    {
        if (_khach == null || _dsFile.Count == 0) return;
        _dangGui = true; _loi = null;
        var req = new BaoGiaRequest { HinhThucNhan = "TAI_QUAY", InGap = _inGap, MaCodeKhuyenMai = _maCode, FileIn = TaoDongIn() };
        // API tự lấy chi nhánh từ token nhưng request báo giá vẫn cần mã chi nhánh; đọc từ endpoint hồ sơ.
        try
        {
            NguoiDungDto nd = await Http.GetFromJsonAsync<NguoiDungDto>("api/auth/me");
            req.MaChiNhanh = PhamVi.MaChiNhanh ?? nd.MaChiNhanh ?? 0;
            var res = await Http.PostAsJsonAsync("api/bao-gia?maKhachHang=" + _khach.MaKhachHang, req);
            if (res.IsSuccessStatusCode) _baoGia = await res.Content.ReadFromJsonAsync<BaoGiaResponse>();
            else _loi = (await res.Content.ReadFromJsonAsync<ApiError>()).Message;
        }
        catch { _loi = "Không tính được báo giá."; }
        _dangGui = false;
    }

    private async Task LapDonAsync()
    {
        _dangGui = true; _loi = null; _thongBao = null;
        var req = new DatDonTaiQuayRequest { MaKhachHang = _khach.MaKhachHang, PhuongThucThanhToan = _phuongThucThanhToan, InGap = _inGap, MaCodeKhuyenMai = _maCode, GhiChu = _ghiChu, FileIn = TaoDongIn() };
        try
        {
            var res = await Http.PostAsJsonAsync("api/don-hang/tai-quay", req);
            if (res.IsSuccessStatusCode)
            {
                DatDonHangResponse kq = await res.Content.ReadFromJsonAsync<DatDonHangResponse>();
                _thongBao = kq.Message + " " + kq.MaDonHangHienThi + " · " + Tien(kq.TongTien) + ".";
                _maDonVuaLap = kq.MaDonHang;
                _lienKetPayOS = null;
                if (kq.PhuongThucThanhToan == "VIETQR") await TaoLienKetPayOSAsync();
                else _thanhToanVuaLap = null;
                _dsFile.Clear(); _baoGia = null; _ghiChu = "";
            }
            else _loi = (await res.Content.ReadFromJsonAsync<ApiError>()).Message;
        }
        catch { _loi = "Không lập được đơn tại quầy."; }
        _dangGui = false;
    }

    private async Task TaiLaiThanhToanAsync()
    {
        if (_maDonVuaLap == null) return;
        try
        {
            var res = await Http.GetAsync("api/thanh-toan/" + _maDonVuaLap);
            if (res.IsSuccessStatusCode) _thanhToanVuaLap = await res.Content.ReadFromJsonAsync<ThanhToanDto>();
            else _loi = (await res.Content.ReadFromJsonAsync<ApiError>()).Message;
        }
        catch { _loi = "Không tải được trạng thái thanh toán payOS."; }
    }

    private async Task TaoLienKetPayOSAsync()
    {
        if (_maDonVuaLap == null) return;
        _loi = null;
        try
        {
            var res = await Http.PostAsync("api/thanh-toan/" + _maDonVuaLap + "/payos", null);
            if (res.IsSuccessStatusCode)
                _lienKetPayOS = await res.Content.ReadFromJsonAsync<LienKetPayOSDto>();
            else
                _loi = (await res.Content.ReadFromJsonAsync<ApiError>()).Message;
        }
        catch { _loi = "Không tạo được mã QR payOS."; }
        await TaiLaiThanhToanAsync();
    }

    private static readonly System.Globalization.NumberFormatInfo KieuSoVietNam = new() { NumberGroupSeparator = ".", NumberDecimalSeparator = "," };
    private string Tien(decimal so) => so.ToString("#,##0", KieuSoVietNam) + "₫";
}
