@page "/lap-don-tai-quay"
@attribute [Authorize(Roles = "SUPER_ADMIN,BRANCH_ADMIN,STAFF")]
@inject HttpClient Http
@inject PhienDangNhap Phien
@inject PhamViChiNhanh PhamVi
@inject IJSRuntime Js
@using PhotocopyShared.QuyCachIn

<PageTitle>Lập đơn tại quầy · PhotocopyChain</PageTitle>
<TieuDeTrang TieuDe="Lập đơn tại quầy" MoTa="Khách chọn quét QR payOS hoặc COD · thanh toán khi nhận tài liệu" />

<div class="than-trang khoi-doc">
    @if (_loi != null) { <div class="o-loi"><span>@_loi</span></div> }
    @if (_thongBao != null) { <div class="o-thanh-cong the-rong"><span>@_thongBao</span></div> }

    @if (_thanhToanVuaLap != null && _thanhToanVuaLap.PhuongThuc == "VIETQR")
    {
        <div class="the the-rong">
            <h2 class="the-tieu-de nho">Thanh toán payOS cho @_thanhToanVuaLap.MaDonHangHienThi</h2>
            <dl class="bang-thong-tin gon">
                <dt>Số tiền</dt><dd class="mono hd-tong">@Tien(_thanhToanVuaLap.SoTien)</dd>
                <dt>Trạng thái</dt><dd><span class="nhan-mau @(_thanhToanVuaLap.TrangThai == "DA_THANH_TOAN" ? "nhan-xanh" : "nhan-cam")">@(_thanhToanVuaLap.TrangThai == "DA_THANH_TOAN" ? "Đã thanh toán" : "Chờ chuyển khoản")</span></dd>
                @if (_lienKetPayOS != null)
                {
                    <dt>Hạn thanh toán</dt><dd>@_lienKetPayOS.HanThanhToan.ToString("dd/MM/yyyy HH:mm")</dd>
                }
            </dl>
            <div class="xac-nhan-o">
                <button class="nut-nho" @onclick="TaiLaiThanhToanAsync">Kiểm tra thanh toán</button>
                @if (_thanhToanVuaLap.TrangThai == "DA_THANH_TOAN")
                {
                    <a class="nut-nho chinh" href="/?maDonHang=@_thanhToanVuaLap.MaDonHang&thanhToan=thanh-cong">Xem đơn trong hàng đợi</a>
                }
                @if (_thanhToanVuaLap.TrangThai != "DA_THANH_TOAN" && _lienKetPayOS != null)
                {
                    <a class="nut-nho chinh" href="@_lienKetPayOS.CheckoutUrl" target="_blank" rel="noopener noreferrer">Mở mã QR payOS</a>
                }
                else if (_thanhToanVuaLap.TrangThai != "DA_THANH_TOAN")
                {
                    <button class="nut-nho chinh" disabled="@_dangGui" @onclick="TaoLienKetPayOSAsync">Tạo lại mã QR payOS</button>
                }
            </div>
        </div>
    }

    <div class="luoi-hai-cot">
        <form @onsubmit="ChonKhachAsync" @onsubmit:preventDefault class="the">
            <h2 class="the-tieu-de nho">1. Khách hàng</h2>
            <p class="the-mo-ta nho">Nhập họ tên hoặc số điện thoại; không bắt buộc nhập cả hai. Có SĐT để tìm lại khách đã có.</p>
            <div class="truong">
                <label class="nhan">Họ tên</label>
                <div class="o-nhap"><input maxlength="100" @bind="_hoTen" placeholder="Nguyễn Văn An" /></div>
            </div>
            <div class="truong">
                <label class="nhan">Số điện thoại</label>
                <div class="o-nhap"><input inputmode="numeric" pattern="0[0-9]{9}" title="Nếu nhập: 10 chữ số, bắt đầu bằng 0" maxlength="10" @bind="_soDienThoai" placeholder="09xxxxxxxx" /></div>
            </div>
            <button type="submit" class="nut-chinh" disabled="@(_dangGui || _dangTaiFile)">Tìm / tạo khách hàng</button>

            @if (_khach != null)
            {
                <div class="o-thanh-cong"><span>@_khach.HoTen @(string.IsNullOrWhiteSpace(_khach.SoDienThoai) ? "" : "· " + _khach.SoDienThoai) @(_khach.VuaTao ? "· vừa tạo" : "· đã có tài khoản")</span></div>
            }
        </form>

        <div class="the">
            <h2 class="the-tieu-de nho">2. Tài liệu</h2>
            <div class="truong">
                <label class="nhan" for="ldq-loai-dich-vu">Dịch vụ đặt in</label>
                <select id="ldq-loai-dich-vu" class="ca-o-loc" @bind="_loaiTai" @bind:after="DoiLoaiTaiAsync" disabled="@(_dsFile.Count > 0 || _dangGui || _dangTaiFile)">
                    <option value="TAI_LIEU">In tài liệu của khách</option>
                    <option value="MAU_DON">In mẫu đơn trống để viết tay</option>
                    <option value="ANH_THE">In ảnh thẻ · tính từng ảnh</option>
                    <option value="SAO_CHUP">Sao chụp giấy tờ/thẻ · hai mặt trên A4</option>
                </select>
            </div>
            @if (LaAnhThe)
            {
                <div class="ca-loc-luoi">
                    <div class="truong"><label class="nhan">Kích thước mỗi ảnh</label>
                        <select class="ca-o-loc" @bind="_kichThuocAnh" @bind:after="DoiQuyCachAnh" disabled="@(_dsFile.Count > 0 || _dangTaiFile || _dangGui)">
                            @foreach (var qc in QuyCachAnhThe.DanhSach) { <option value="@qc.Ma">@qc.Ten</option> }
                        </select>
                    </div>
                    <div class="truong"><label class="nhan">Số ảnh mỗi file</label>
                        <input class="ca-o-loc" type="number" min="1" max="100" step="1" @bind="_soLuongAnh" disabled="@(_dsFile.Count > 0 || _dangTaiFile || _dangGui)" />
                    </div>
                </div>
                <p class="the-mo-ta nho">Giữ tỉ lệ ảnh, thêm nền trắng nếu lệch tỉ lệ; không tự cắt khuôn mặt. Ghép đúng số ảnh trên PDF A4 và in 100% kích thước. Muốn đổi số ảnh, xóa file rồi tải lại.</p>
                @if (_maDichVu == 0) { <div class="o-canh-bao">Chi nhánh chưa bán kích thước ảnh này. Kiểm tra dịch vụ và bảng giá.</div> }
            }
            @if (_khach == null)
            {
                <p class="the-mo-ta nho">Chọn khách hàng trước khi tải file.</p>
            }
            else
            {
                @if (_loaiTai == "MAU_DON")
                {
                    <p class="the-mo-ta">Chọn bản trống từ file tải sẵn. Xem đúng biểu mẫu và nguồn trước khi đặt in.</p>
                    <section class="mau-khung-thu-vien" aria-label="Thư viện mẫu đơn">
                    <div class="mau-thanh-dau">
                        <div><strong>Thư viện mẫu đơn</strong><span>@_dsMau.Count mẫu có sẵn · 6 mẫu mỗi trang</span></div>
                        <button type="button" class="nut-nho" disabled="@(_dangTaiFile || _dangGui || _dangXemMau || _dangTaiMau)" @onclick="TaiThuVienMauAsync">Làm mới thư viện mẫu</button>
                        <button type="button" class="nut-nho" disabled="@(_timMau == "" && _nhomMau == "")" @onclick="XoaLocMau">Xóa bộ lọc mẫu</button>
                    </div>
                    <div class="mau-bo-loc">
                        <div class="truong"><label class="nhan" for="mau-tu-khoa">Tìm mẫu đơn</label>
                            <input id="mau-tu-khoa" class="ca-o-loc" placeholder="Tên mẫu hoặc nơi công bố" @bind="_timMau" @bind:event="oninput" @bind:after="VeTrangDauMau" />
                        </div>
                        <div class="truong"><label class="nhan" for="mau-nhom">Nhóm mẫu</label>
                            <select id="mau-nhom" class="ca-o-loc" @bind="_nhomMau" @bind:after="VeTrangDauMau"><option value="">Tất cả</option>
                                @foreach (var nhom in _dsMau.Select(x => x.Nhom).Distinct()) { <option value="@nhom">@nhom</option> }
                            </select>
                        </div>
                    </div>
                    <div id="mau-danh-sach" class="mau-danh-sach" role="region" aria-label="Danh sách mẫu đơn" tabindex="0" @key="(_timMau, _nhomMau, TrangThuVienMau)">
                    <div class="mau-thu-vien">
                    @foreach (var mau in MauTrenTrang)
                    {
                        <article class="mau-the" @key="mau.MaMau">
                            <div class="mau-the-noi-dung">
                            <span class="nv-phu">@mau.Nhom · @mau.SoTrang trang</span>
                            <h3>@mau.TenMau</h3>
                            </div>
                            <button type="button" class="nut-nho mau-nut-xem" disabled="@(_dangGui || _dangTaiFile || _dangXemMau)" @onclick="() => XemMauAsync(mau)">Xem mẫu</button>
                            <details><summary>Thông tin &amp; nguồn</summary>
                                <p><strong>@mau.Nguon</strong></p><p>@mau.MoTa</p><p>@mau.PhamVi</p>
                                @if (!string.IsNullOrWhiteSpace(mau.UrlNguon)) { <a href="@mau.UrlNguon" target="_blank" rel="noopener noreferrer">Xem nguồn công bố</a> }
                            </details>
                        </article>
                    }
                    </div>
                    @if (_dsMau.Count == 0) { <button class="nut-nho" @onclick="DoiLoaiTaiAsync">Tải lại mẫu đơn</button> }
                    else if (!MauDaLoc.Any()) { <p role="status">Không có mẫu phù hợp. Thử tên khác hoặc chọn tất cả nhóm.</p> }
                    </div>
                    <nav class="mau-phan-trang" aria-label="Phân trang thư viện mẫu">
                        <span class="nv-phu" role="status">@SoMauDaLoc mẫu phù hợp · Trang @TrangThuVienMau / @SoTrangThuVienMau</span>
                        <div>
                            <button type="button" class="nut-nho" aria-controls="mau-danh-sach" disabled="@(TrangThuVienMau <= 1)" @onclick="() => DoiTrangThuVienMau(TrangThuVienMau - 1)">Trang mẫu trước</button>
                            <button type="button" class="nut-nho" aria-controls="mau-danh-sach" disabled="@(TrangThuVienMau >= SoTrangThuVienMau)" @onclick="() => DoiTrangThuVienMau(TrangThuVienMau + 1)">Trang mẫu sau</button>
                        </div>
                    </nav>
                    </section>
                    @if (_dangXemMau) { <p role="status">Đang mở bản xem trước…</p> }
                }
                else if (LaSaoChup)
                {
                    @if (_maDichVu == 0) { <div class="o-canh-bao">Chi nhánh chưa có giá in A4 một mặt. Hãy cấu hình bảng giá trước khi lập đơn sao chụp.</div> }
                    <p class="the-mo-ta">Dùng bảng máy quét bên dưới để lấy hai mặt thẻ và kiểm tra bản ghép trước khi lập đơn.</p>
                }
                else
                {
                    <InputFile OnChange="TaiFileAsync" multiple accept="@(LaAnhThe ? ".png,.jpg,.jpeg" : null)" disabled="@(_dangGui || _dangTaiFile || (LaAnhThe && (_soLuongAnh < 1 || _soLuongAnh > 100 || _maDichVu == 0)))" />
                }
                @if (_mauXem != null)
                {
                    <p class="nv-phu">Mẫu vừa xem: @_mauDangXem.TenMau</p>
                }
                @if (_dangTaiFile && !LaSaoChup) { <p class="the-mo-ta nho">Đang chuẩn hóa PDF và đếm trang…</p> }
                @foreach (FileInDto file in _dsFile)
                {
                    <div class="hd-dong-in">
                        <b>@file.TenFileGoc</b>
                        <span class="nv-phu">@(file.KichThuocAnh != null ? file.SoLuongAnh + " ảnh · " + QuyCachAnhThe.Lay(file.KichThuocAnh)?.Ten + " · " : "")@file.SoTrang trang PDF</span>
                        <button class="nut-nho nguy-hiem" disabled="@(_dangGui || _dangTaiFile)" @onclick="() => XoaFileAsync(file)">Xóa</button>
                    </div>
                }
            }
        </div>
    </div>

    @if (_khach != null && LaSaoChup)
    {
        <div class="the the-rong">
            <MayQuetAo @key="(_khach.MaKhachHang, _lanPhienQuet)" MaKhachHang="_khach.MaKhachHang"
                Khoa="@(_dangGui || _dangTaiFile || _dsFile.Count > 0 || _maDichVu == 0)"
                DangXuLyThayDoi="DangQuetThayDoi" FileDaTao="NhanFileSaoChupAsync" />
        </div>
    }

    @if (_khach != null && _dsFile.Count > 0)
    {
        <form @onsubmit="GuiQuyCachAsync" @onsubmit:preventDefault class="the the-rong">
            <h2 class="the-tieu-de nho">3. Quy cách và báo giá</h2>
            <div class="ca-loc-luoi">
                @if (LaAnhThe)
                {
                    <p class="the-mo-ta">Ảnh thẻ @QuyCachAnhThe.Lay(_kichThuocAnh)?.Ten · Giấy ảnh A4 · In màu một mặt · Giá theo từng ảnh. Không nhân số bản hoặc gia công tài liệu.</p>
                }
                else
                {
                <div class="truong">
                    <label class="nhan">Giấy in trong kho</label>
                    <select class="ca-o-loc" value="@_khoaGiay" @onchange="DoiKhoGiay">
                        @foreach (DichVuDto dv in DsKhoGiay())
                        {
                            <option value="@KhoaGiay(dv)">@(string.IsNullOrWhiteSpace(dv.TenVatTu) ? dv.KhoGiay + " " + dv.LoaiGiay : dv.TenVatTu)</option>
                        }
                    </select>
                    <small class="nv-phu">Giấy đã cấu hình dịch vụ và đang bán tại chi nhánh.</small>
                </div>
                <div class="truong">
                    <label class="nhan">Mặt in</label>
                    <select class="ca-o-loc" value="@_matIn" @onchange="DoiMatIn">
                        @foreach (string mat in DsMatIn())
                        {
                            <option value="@mat">@(mat == "2_MAT" ? "In 2 mặt" : "In 1 mặt")</option>
                        }
                    </select>
                </div>
                <div class="truong">
                    <label class="nhan">Hướng giấy</label>
                    <select class="ca-o-loc" @bind="_huongGiay" @bind:after="XoaBaoGia" disabled="@LaSaoChup">
                        <option value="DUNG">Giấy đứng</option>
                        <option value="NGANG">Giấy ngang</option>
                    </select>
                </div>
                <div class="truong">
                    <label class="nhan">Màu sắc</label>
                    <select class="ca-o-loc" value="@_mauSac" @onchange="DoiMauSac">
                        @foreach (string mau in DsMauSac())
                        {
                            <option value="@mau">@(mau == "MAU" ? "In màu" : "Đen trắng")</option>
                        }
                    </select>
                </div>
                <div class="truong">
                    <label class="nhan">Số bản mỗi file</label>
                    <input max="2147483647" required step="1" class="ca-o-loc" type="number" min="1" @bind="_soBan" @bind:after="XoaBaoGia" />
                </div>
                }
            </div>

            <div class="ldq-thanh-toan-khuyen-mai">
                <div class="truong ldq-thanh-toan">
                    <label class="nhan" for="ldq-thanh-toan">Thanh toán</label>
                    <select id="ldq-thanh-toan" class="ca-o-loc" @bind="_phuongThucThanhToan">
                        <option value="VIETQR">Quét QR payOS tại quầy</option>
                        <option value="COD">COD · trả khi nhận tài liệu</option>
                    </select>
                </div>
                <div class="truong ldq-khuyen-mai">
                    <label class="nhan" for="ldq-ma-khuyen-mai">Mã khuyến mãi</label>
                    <input id="ldq-ma-khuyen-mai" maxlength="30" class="ca-o-loc mono" @bind="_maCode" @bind:after="XoaBaoGia" />
                </div>
                <div class="truong ldq-toc-do">
                    <label class="nhan" for="ldq-toc-do">Tốc độ xử lý</label>
                    <select id="ldq-toc-do" class="ca-o-loc" @bind="KieuIn" @bind:after="DoiKieuInAsync" disabled="@(_dangGui || _dangTaiFile)">
                        <option value="THUONG">In thường · theo hàng đợi</option>
                        <option value="HOA_TOC">In hỏa tốc (+10.000₫)</option>
                    </select>
                </div>
            </div>

            <div class="o-canh-bao" role="status" aria-live="polite">
                <div>
                    <div><b>@(_inGap ? "In hỏa tốc · ưu tiên xử lý" : "In thường · theo hàng đợi")</b></div>
                    @if (_dangBaoGia)
                    {
                        <div>Đang tính giờ nhận dự kiến…</div>
                    }
                    else if (_baoGia?.NgayHenTra != null)
                    {
                        <div>Giờ nhận dự kiến: <b>@_baoGia.NgayHenTra.Value.ToString("HH:mm dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture)</b></div>
                        <div class="nv-phu">Ước tính theo số trang, hàng đợi và tốc độ máy; có thể thay đổi theo tình trạng xử lý thực tế.</div>
                    }
                    else
                    {
                        <div>@(_baoGia == null ? "Bấm Tính lại giá để cập nhật giờ nhận theo quy cách đã chọn." : "Chưa ước tính được giờ nhận. Vui lòng kiểm tra máy in của chi nhánh.")</div>
                    }
                </div>
            </div>

            @if (!LaAnhThe)
            {
            <h3 class="hd-muc">Gia công</h3>
            <div class="thanh-loc">
                @foreach (DichVuDto dv in _dsDichVu.Where(x => x.LoaiDichVu == "GIA_CONG"))
                {
                    <label class="hop-chon">
                        <input type="checkbox" checked="@_dsGiaCong.Contains(dv.MaDichVu)" disabled="@(QuyTacIn.LaKimGoc(dv.TenDichVu) && !KimGocHopLe())" @onchange="e => DoiGiaCong(dv, (bool)e.Value)" />
                        <span class="o-vuong">✓</span>@dv.TenDichVu · @Tien(dv.DonGia)/bản
                    </label>
                }
            </div>
            <p class="nv-phu">Kim góc: tối đa 50 tờ giấy mỗi file, mỗi bản. Bìa kiếng và ép plastic có thể đi cùng lò xo; lò xo không chọn cùng kim góc.</p>
            @if (!KimGocHopLe())
            {
                <div class="o-canh-bao">Có file vượt 50 tờ/bản theo mặt in hiện tại, không thể chọn bấm kim góc.</div>
            }
            @if (_thongBaoGiaCong != null)
            {
                <div class="o-canh-bao"><span>@_thongBaoGiaCong</span></div>
            }
            }

            <div class="truong">
                <label class="nhan">Ghi chú cho thợ in</label>
                <div class="o-nhap"><input maxlength="255" @bind="_ghiChu" placeholder="Ví dụ: bấm kim góc trái" /></div>
            </div>

            @if (_baoGia != null)
            {
                <dl class="bang-thong-tin gon">
                    <dt>Tiền in</dt><dd class="mono">@Tien(_baoGia.TienIn)</dd>
                    <dt>Gia công</dt><dd class="mono">@Tien(_baoGia.TienGiaCong)</dd>
                    @foreach (DichVuDto giaCong in DsGiaCongDaChon())
                    {
                        decimal thanhTienGiaCong = giaCong.DonGia * _soBan * _dsFile.Count;
                        <dt class="nv-phu">↳ @giaCong.TenDichVu (@Tien(giaCong.DonGia) × @_soBan bản × @_dsFile.Count file)</dt>
                        <dd class="mono nv-phu">@Tien(thanhTienGiaCong)</dd>
                    }
                    <dt>Phụ phí hỏa tốc</dt><dd class="mono">@Tien(_baoGia.PhuPhiGap)</dd>
                    <dt>Giảm giá</dt><dd class="mono">−@Tien(_baoGia.GiamGia)</dd>
                    <dt>@(_phuongThucThanhToan == "VIETQR" ? "Tổng thanh toán" : "Tổng thu khi giao")</dt><dd class="mono hd-tong">@Tien(_baoGia.TongTien)</dd>
                </dl>
                @if (_baoGia.KhuyenMaiHopLe == false) { <div class="o-canh-bao"><span>@_baoGia.LyDoKhuyenMai</span></div> }
            }

            <div class="xac-nhan-o">
                <button type="submit" class="nut-nho" disabled="@(_dangGui || _dangTaiFile)" @onclick="() => _chiBaoGia = true">Tính lại giá</button>
                <button type="submit" class="nut-nho chinh" disabled="@(_dangGui || _dangTaiFile || _baoGia == null)" @onclick="() => _chiBaoGia = false">@(_phuongThucThanhToan == "VIETQR" ? "Lập đơn & hiện mã QR" : "Lập đơn COD")</button>
            </div>
        </form>
    }
</div>
<XacNhanThaoTac @ref="_xacNhan" />
<dialog class="mau-xem-truoc" @ref="_hopMau" aria-label="Bản xem trước mẫu đơn" aria-labelledby="mau-xem-tieu-de">
    @if (_mauDangXem != null)
    {
        <div class="mau-thanh-cong-cu">
        <h3 id="mau-xem-tieu-de">@_mauDangXem.TenMau · @_mauDangXem.SoTrang trang</h3>
        <p>@_mauDangXem.PhamVi</p>
        @if (_loi != null) { <div class="o-loi" role="alert">@_loi</div> }
        <button class="nut-nho chinh" disabled="@(_dangGui || _dangTaiFile || _dangXemMau || _mauXem == null)" @onclick="() => ChonMauAsync(_mauDangXem)">Chọn mẫu này để in</button>
        <button class="nut-nho" autofocus @onclick="DongXemMauAsync">Đóng bản xem trước</button>
        <div class="mau-dieu-khien">
            <button class="nut-nho" disabled="@(_dangXemMau || _trangMau <= 1)" @onclick="() => TaiTrangMauAsync(_trangMau - 1)">Trang trước</button>
            <span aria-live="polite">Trang @_trangMau / @_mauDangXem.SoTrang</span>
            <button class="nut-nho" disabled="@(_dangXemMau || _trangMau >= _mauDangXem.SoTrang)" @onclick="() => TaiTrangMauAsync(_trangMau + 1)">Trang sau</button>
            <button class="nut-nho" @onclick="() => _phongMau = Math.Max(1, _phongMau - 0.5)">Thu nhỏ</button>
            <button class="nut-nho" @onclick="() => _phongMau = Math.Min(3, _phongMau + 0.5)">Phóng to</button>
        </div>
        </div>
        <div class="mau-anh-khung">
            @if (_dangXemMau) { <p role="status">Đang tải trang mẫu…</p> }
            else if (_mauXem != null)
            {
                <img class="mau-anh" src="@_mauXem" alt="@(_mauDangXem.TenMau + ", trang " + _trangMau)"
                     style="width:auto;height:@(_phongMau * 100)%" />
            }
            else { <button class="nut-nho" @onclick="() => TaiTrangMauAsync(_trangMau)">Thử tải lại trang</button> }
        </div>
    }
</dialog>

@code {
    private XacNhanThaoTac _xacNhan;
    [Parameter]
    [SupplyParameterFromQuery(Name = "maDonHang")]
    public int? MaDonHangTuPayOS { get; set; }

    private string _hoTen = "";
    private string _soDienThoai = "";
    private KhachTaiQuayDto _khach;
    private List<FileInDto> _dsFile = new();
    private string _loaiTai = "TAI_LIEU";
    private string _kichThuocAnh = "3X4";
    private int _soLuongAnh = 8;
    private bool LaAnhThe => _loaiTai == "ANH_THE";
    private bool LaSaoChup => _loaiTai == "SAO_CHUP";
    private int _lanPhienQuet;
    private List<MauDonDto> _dsMau = new();
    private string _mauXem;
    private MauDonDto _mauDangXem;
    private ElementReference _hopMau;
    private bool _canMoMau;
    private int _trangMau = 1;
    private double _phongMau = 1.5;
    private bool _dangXemMau;
    private string _timMau = "";
    private string _nhomMau = "";
    private const int SoMauMoiTrang = 6;
    private int _trangThuVienMau = 1;
    private IEnumerable<MauDonDto> MauDaLoc => _dsMau.Where(x =>
        (_nhomMau == "" || x.Nhom == _nhomMau) &&
        (x.TenMau.Contains(_timMau.Trim(), StringComparison.CurrentCultureIgnoreCase)
         || x.Nguon.Contains(_timMau.Trim(), StringComparison.CurrentCultureIgnoreCase)));
    private int SoMauDaLoc => MauDaLoc.Count();
    private int SoTrangThuVienMau => Math.Max(1, (SoMauDaLoc + SoMauMoiTrang - 1) / SoMauMoiTrang);
    private int TrangThuVienMau => Math.Clamp(_trangThuVienMau, 1, SoTrangThuVienMau);
    private IEnumerable<MauDonDto> MauTrenTrang => MauDaLoc.Skip((TrangThuVienMau - 1) * SoMauMoiTrang).Take(SoMauMoiTrang);
    private void VeTrangDauMau() => _trangThuVienMau = 1;
    private void DoiTrangThuVienMau(int trang) => _trangThuVienMau = Math.Clamp(trang, 1, SoTrangThuVienMau);
    private void XoaLocMau() { _timMau = ""; _nhomMau = ""; VeTrangDauMau(); }

    private async Task DoiLoaiTaiAsync()
    {
        _mauXem = null; _mauDangXem = null; _timMau = ""; _nhomMau = "";
        VeTrangDauMau();
        _loi = null; _soBan = 1; _huongGiay = "DUNG"; _dsGiaCong.Clear();
        DoiQuyCachAnh();
        if (_loaiTai != "MAU_DON") return;
        await TaiThuVienMauAsync();
    }

    private bool _dangTaiMau;
    private async Task TaiThuVienMauAsync()
    {
        if (_dangTaiMau) return;
        _dangTaiMau = true; _loi = null;
        try
        {
            _dsMau = await Http.GetFromJsonAsync<List<MauDonDto>>("api/file-in/mau") ?? new();
            if (!_dsMau.Any(x => x.Nhom == _nhomMau)) _nhomMau = "";
            VeTrangDauMau();
        }
        catch { _loi = "Không tải được mẫu đơn. Bạn có thể thử lại."; }
        finally { _dangTaiMau = false; }
    }

    private IEnumerable<DichVuDto> DichVuInHopLe() => _dsDichVu.Where(x => x.LoaiDichVu == "IN_AN" &&
        (LaAnhThe ? x.KichThuocAnh == _kichThuocAnh : x.KichThuocAnh == null) &&
        (!LaSaoChup || (x.KhoGiay == "A4" && x.MatIn == "1_MAT")));

    private void DangQuetThayDoi(bool dang) => _dangTaiFile = dang;
    private async Task NhanFileSaoChupAsync(FileInDto file)
    {
        _dsFile.Add(file); XoaBaoGia();
        await BaoGiaAsync();
    }

    private void DoiQuyCachAnh()
    {
        _maDichVu = 0; XoaBaoGia();
        var dv = DichVuInHopLe().FirstOrDefault();
        if (dv != null) ApDungDichVu(dv);
    }

    private async Task XemMauAsync(MauDonDto mau)
    {
        if (_dangXemMau) return;
        _mauDangXem = mau; _canMoMau = true; _phongMau = 1.5;
        await TaiTrangMauAsync(1);
    }

    private async Task TaiTrangMauAsync(int trang)
    {
        if (_dangXemMau || _mauDangXem == null || trang < 1 || trang > _mauDangXem.SoTrang) return;
        string maMau = _mauDangXem.MaMau;
        _dangXemMau = true; _loi = null; _mauXem = null;
        _trangMau = trang; _phongMau = 1.5;
        try
        {
            byte[] bytes = await Http.GetByteArrayAsync("api/file-in/mau/" + maMau + "/trang/" + trang + "?phienBan=" + _mauDangXem.PhienBan);
            if (_loaiTai != "MAU_DON" || _mauDangXem?.MaMau != maMau) return;
            _mauXem = "data:image/png;base64," + Convert.ToBase64String(bytes);
        }
        catch { _loi = "Không mở được bản xem trước. Mẫu có thể đã đổi hoặc ẩn; hãy làm mới thư viện mẫu."; }
        finally { _dangXemMau = false; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_canMoMau) return;
        _canMoMau = false;
        await Js.InvokeVoidAsync("moMauDon", _hopMau);
    }

    private async Task DongXemMauAsync()
    {
        await Js.InvokeVoidAsync("dongMauDon", _hopMau);
        _mauXem = null; _mauDangXem = null;
    }

    private async Task ChonMauAsync(MauDonDto mau)
    {
        if (_khach == null || mau == null || _loaiTai != "MAU_DON" || _dangGui || _dangTaiFile) return;
        _dangTaiFile = true; _loi = null; XoaBaoGia();
        try
        {
            using var res = await Http.PostAsync("api/file-in/mau/" + mau.MaMau + "?maKhachHang=" + _khach.MaKhachHang + "&phienBan=" + mau.PhienBan, null);
            if (res.IsSuccessStatusCode)
            {
                _dsFile.Add(await res.Content.ReadFromJsonAsync<FileInDto>());
                await DongXemMauAsync();
            }
            else _loi = (await res.Content.ReadFromJsonAsync<ApiError>()).Message;
        }
        catch { _loi = "Không tạo được file mẫu đơn."; }
        finally { _dangTaiFile = false; }
        if (_dsFile.Count > 0) await BaoGiaAsync();
    }
    private string _huongGiay = "DUNG";
    private List<DichVuDto> _dsDichVu = new();
    private List<int> _dsGiaCong = new();
    private int _maDichVu;
    private string _khoaGiay = "";
    private string _matIn = "";
    private string _mauSac = "";
    private int _soBan = 1;
    private bool _inGap;
    private string KieuIn
    {
        get => _inGap ? "HOA_TOC" : "THUONG";
        set => _inGap = value == "HOA_TOC";
    }
    private string _maCode = "";
    private string _ghiChu = "";
    private string _phuongThucThanhToan = "VIETQR";
    private BaoGiaResponse _baoGia;
    private ThanhToanDto _thanhToanVuaLap;
    private LienKetPayOSDto _lienKetPayOS;
    private int? _maDonVuaLap;
    private bool _dangGui;
    private bool _dangBaoGia;
    private int _lanBaoGia;
    private bool _dangTaiFile;
    private string _loi;
    private string _thongBao;
    private string _thongBaoGiaCong;

    protected override async Task OnInitializedAsync()
    {
        if (MaDonHangTuPayOS != null)
        {
            _maDonVuaLap = MaDonHangTuPayOS;
            await TaiLaiThanhToanAsync();
            if (_thanhToanVuaLap?.TrangThai == "DA_THANH_TOAN")
                _thongBao = "Đã nhận thanh toán cho " + _thanhToanVuaLap.MaDonHangHienThi + ".";
        }

        try
        {
            int maChiNhanh = PhamVi.MaChiNhanh ?? Phien.NguoiDung?.MaChiNhanh ?? 0;
            if (maChiNhanh <= 0)
            {
                _loi = "Hãy chọn một chi nhánh để tiếp tục lập đơn tại quầy.";
                return;
            }

            _dsDichVu = await Http.GetFromJsonAsync<List<DichVuDto>>("api/danh-muc/bang-gia?maChiNhanh=" + maChiNhanh) ?? new();
            DichVuDto dau = DichVuInHopLe().FirstOrDefault();
            if (dau != null) ApDungDichVu(dau);
        }
        catch { _loi = "Không tải được bảng giá."; }
    }

    private string KhoaGiay(DichVuDto dichVu) => (dichVu.KhoGiay ?? "") + "|" + (dichVu.LoaiGiay ?? "") + "|" + dichVu.MaVatTu;

    private List<DichVuDto> DsKhoGiay()
    {
        return DichVuInHopLe()
            .GroupBy(KhoaGiay).Select(x => x.First()).ToList();
    }

    private List<string> DsMatIn()
    {
        return DichVuInHopLe().Where(x => KhoaGiay(x) == _khoaGiay)
            .Select(x => x.MatIn).Where(x => x != null).Distinct().ToList();
    }

    private List<string> DsMauSac()
    {
        return DichVuInHopLe().Where(x => KhoaGiay(x) == _khoaGiay && x.MatIn == _matIn)
            .Select(x => x.MauSac).Where(x => x != null).Distinct().ToList();
    }

    private void ApDungDichVu(DichVuDto dichVu)
    {
        _maDichVu = dichVu.MaDichVu;
        _khoaGiay = KhoaGiay(dichVu);
        _matIn = dichVu.MatIn ?? "";
        _mauSac = dichVu.MauSac ?? "";
        KiemTraKimGoc();
        XoaBaoGia();
    }

    private void DoiKhoGiay(ChangeEventArgs e)
    {
        _khoaGiay = e.Value?.ToString() ?? "";
        List<DichVuDto> ds = DichVuInHopLe().Where(x => KhoaGiay(x) == _khoaGiay).ToList();
        DichVuDto chon = ds.FirstOrDefault(x => x.MatIn == _matIn && x.MauSac == _mauSac) ?? ds.FirstOrDefault();
        if (chon != null) ApDungDichVu(chon);
    }

    private void DoiMatIn(ChangeEventArgs e)
    {
        _matIn = e.Value?.ToString() ?? "";
        List<DichVuDto> ds = DichVuInHopLe().Where(x => KhoaGiay(x) == _khoaGiay && x.MatIn == _matIn).ToList();
        DichVuDto chon = ds.FirstOrDefault(x => x.MauSac == _mauSac) ?? ds.FirstOrDefault();
        if (chon != null) ApDungDichVu(chon);
    }

    private void DoiMauSac(ChangeEventArgs e)
    {
        _mauSac = e.Value?.ToString() ?? "";
        DichVuDto chon = DichVuInHopLe().FirstOrDefault(x => KhoaGiay(x) == _khoaGiay &&
            x.MatIn == _matIn && x.MauSac == _mauSac);
        if (chon != null) ApDungDichVu(chon);
    }

    private List<DichVuDto> DsGiaCongDaChon()
    {
        return _dsDichVu.Where(x => _dsGiaCong.Contains(x.MaDichVu)).ToList();
    }

    private async Task ChonKhachAsync()
    {
        if (_dangGui || _dangTaiFile) return;
        var req = new KhachTaiQuayRequest { HoTen = _hoTen.Trim(), SoDienThoai = _soDienThoai.Trim() };
        _loi = QuyTacNhap.LayLoi(req);
        if (_loi != null) return;
        _dangGui = true; _loi = null; _thongBao = null;
        try
        {
            var res = await Http.PostAsJsonAsync("api/don-hang/khach-tai-quay", req);
            if (res.IsSuccessStatusCode)
            {
                await XoaTatCaFileDangChonAsync();
                _khach = await res.Content.ReadFromJsonAsync<KhachTaiQuayDto>();
                _lanPhienQuet++;
                _dsFile.Clear(); XoaBaoGia(); _thanhToanVuaLap = null; _lienKetPayOS = null; _maDonVuaLap = null;
            }
            else _loi = (await res.Content.ReadFromJsonAsync<ApiError>()).Message;
        }
        catch { _loi = "Không kết nối được máy chủ API."; }
        _dangGui = false;
    }

    private async Task TaiFileAsync(InputFileChangeEventArgs e)
    {
        if (_khach == null || _dangGui || _dangTaiFile) return;
        XoaBaoGia();
        _dangTaiFile = true; _loi = null;
        foreach (IBrowserFile file in e.GetMultipleFiles(10))
        {
            try
            {
                using var form = new MultipartFormDataContent();
                using var stream = file.OpenReadStream(60 * 1024 * 1024);
                using var noiDung = new StreamContent(stream);
                form.Add(noiDung, "file", file.Name);
                string uri = "api/file-in?maKhachHang=" + _khach.MaKhachHang;
                if (LaAnhThe) uri += "&kichThuocAnh=" + _kichThuocAnh + "&soLuongAnh=" + _soLuongAnh;
                var res = await Http.PostAsync(uri, form);
                if (res.IsSuccessStatusCode) _dsFile.Add(await res.Content.ReadFromJsonAsync<FileInDto>());
                else _loi = (await res.Content.ReadFromJsonAsync<ApiError>()).Message;
            }
            catch { _loi = "Không tải được file " + file.Name + "."; }
        }
        _dangTaiFile = false;
        KiemTraKimGoc();
        if (_dsFile.Count > 0) await BaoGiaAsync();
    }

    private async Task XoaFileAsync(FileInDto file)
    {
        if (_khach == null || _dangGui || _dangTaiFile) return;
        if (!await _xacNhan.HoiAsync("Xóa file “" + file.TenFileGoc + "” khỏi đơn đang lập?", "Xóa tài liệu", "Xóa file", true)) return;
        _dangTaiFile = true;
        _loi = null;
        try
        {
            using var res = await Http.DeleteAsync("api/file-in/" + file.MaFileIn + "?maKhachHang=" + _khach.MaKhachHang);
            if (!res.IsSuccessStatusCode) { _loi = await DocLoiApi.TuPhanHoiAsync(res, "Không xóa được file."); return; }
            _dsFile.Remove(file);
            XoaBaoGia();
        }
        catch (HttpRequestException) { _loi = "Mất kết nối API. Kiểm tra lại file trước khi thử lại."; }
        finally { _dangTaiFile = false; }
    }

    private async Task XoaTatCaFileDangChonAsync()
    {
        if (_khach == null) return;
        foreach (FileInDto file in _dsFile.ToList())
            await Http.DeleteAsync("api/file-in/" + file.MaFileIn + "?maKhachHang=" + _khach.MaKhachHang);
    }

    // Giống App mobile: bìa kiếng đi kèm lò xo; lò xo không đi cùng kim góc.
    private void DoiGiaCong(DichVuDto dichVu, bool chon)
    {
        _thongBaoGiaCong = null;
        if (!chon)
        {
            _dsGiaCong.Remove(dichVu.MaDichVu);
            XoaBaoGia();
            return;
        }

        if (QuyTacIn.LaKimGoc(dichVu.TenDichVu) && !KimGocHopLe())
        {
            _thongBaoGiaCong = "Kim góc chỉ áp dụng tối đa 50 tờ giấy mỗi bản.";
            return;
        }

        List<DichVuDto> dsBiBo = DsGiaCongDaChon().Where(x => x.MaDichVu != dichVu.MaDichVu &&
            QuyTacIn.LoaiTruNhau(x.TenDichVu, x.NhomGiaCong, dichVu.TenDichVu, dichVu.NhomGiaCong)).ToList();
        foreach (DichVuDto biBo in dsBiBo) _dsGiaCong.Remove(biBo.MaDichVu);
        if (dsBiBo.Count > 0)
            _thongBaoGiaCong = "Gia công không thể chọn cùng nhau — đã bỏ \"" +
                string.Join("\", \"", dsBiBo.Select(x => x.TenDichVu)) + "\".";

        if (!_dsGiaCong.Contains(dichVu.MaDichVu)) _dsGiaCong.Add(dichVu.MaDichVu);
        XoaBaoGia();
    }

    private List<DongInRequest> TaoDongIn()
    {
        var ds = new List<DongInRequest>();
        foreach (FileInDto file in _dsFile)
            ds.Add(new DongInRequest { MaFileIn = file.MaFileIn, MaDichVu = _maDichVu, SoBanIn = _soBan, HuongGiay = LaSaoChup ? "DUNG" : _huongGiay, DsGiaCong = new List<int>(_dsGiaCong) });
        return ds;
    }

    private void XoaBaoGia()
    {
        _baoGia = null;
        _lanBaoGia++; // Kết quả đang chờ theo quy cách cũ không được ghi đè lựa chọn mới.
    }

    private async Task DoiKieuInAsync()
    {
        XoaBaoGia();
        await BaoGiaAsync();
    }

    private bool KimGocHopLe() => _dsFile.All(x => x.SoTrang > 0 &&
        QuyTacIn.SoToMoiBan(x.SoTrang.Value, _matIn) <= QuyTacIn.SoToKimGocToiDa);

    private void KiemTraKimGoc()
    {
        if (KimGocHopLe()) return;
        foreach (DichVuDto dv in DsGiaCongDaChon().Where(x => QuyTacIn.LaKimGoc(x.TenDichVu)))
        {
            _dsGiaCong.Remove(dv.MaDichVu);
            _thongBaoGiaCong = "Đã bỏ bấm kim góc vì có file vượt 50 tờ giấy mỗi bản.";
        }
    }

    private bool _chiBaoGia = true;

    private async Task GuiQuyCachAsync()
    {
        if (_dangGui || _dangTaiFile) return;
        if (_chiBaoGia) await BaoGiaAsync();
        else await LapDonAsync();
    }

    private async Task BaoGiaAsync()
    {
        if (_dangGui || _khach == null || _dsFile.Count == 0) return;
        XoaBaoGia();
        int lanBaoGia = _lanBaoGia;
        int maKhachHang = _khach.MaKhachHang;
        _dangGui = true; _dangBaoGia = true; _loi = null;
        var req = new BaoGiaRequest { HinhThucNhan = "TAI_QUAY", InGap = _inGap, MaCodeKhuyenMai = _maCode, FileIn = TaoDongIn() };
        // API tự lấy chi nhánh từ token nhưng request báo giá vẫn cần mã chi nhánh; đọc từ endpoint hồ sơ.
        try
        {
            NguoiDungDto nd = await Http.GetFromJsonAsync<NguoiDungDto>("api/auth/me");
            req.MaChiNhanh = PhamVi.MaChiNhanh ?? nd.MaChiNhanh ?? 0;
            if (lanBaoGia != _lanBaoGia) return;
            using var res = await Http.PostAsJsonAsync("api/bao-gia?maKhachHang=" + maKhachHang, req);
            if (res.IsSuccessStatusCode)
            {
                BaoGiaResponse ketQua = await res.Content.ReadFromJsonAsync<BaoGiaResponse>();
                if (lanBaoGia == _lanBaoGia) _baoGia = ketQua;
            }
            else
            {
                ApiError loi = await res.Content.ReadFromJsonAsync<ApiError>();
                if (lanBaoGia == _lanBaoGia) _loi = loi.Message;
            }
        }
        catch { if (lanBaoGia == _lanBaoGia) _loi = "Không tính được báo giá."; }
        finally { _dangGui = false; _dangBaoGia = false; }
    }

    private async Task LapDonAsync()
    {
        if (_dangGui || _dangTaiFile || _baoGia == null) return;
        if (_khach == null) { _loi = "Vui lòng chọn khách hàng."; return; }
        var req = new DatDonTaiQuayRequest { MaKhachHang = _khach.MaKhachHang, PhuongThucThanhToan = _phuongThucThanhToan, InGap = _inGap, MaCodeKhuyenMai = _maCode, GhiChu = _ghiChu, FileIn = TaoDongIn() };
        _loi = QuyTacNhap.LayLoi(req);
        if (_loi != null) return;
        _dangGui = true; _thongBao = null;
        try
        {
            var res = await Http.PostAsJsonAsync("api/don-hang/tai-quay", req);
            if (res.IsSuccessStatusCode)
            {
                DatDonHangResponse kq = await res.Content.ReadFromJsonAsync<DatDonHangResponse>();
                _thongBao = kq.Message + " " + kq.MaDonHangHienThi + " · " + Tien(kq.TongTien) + ".";
                _maDonVuaLap = kq.MaDonHang;
                _lienKetPayOS = null;
                if (kq.PhuongThucThanhToan == "VIETQR") await TaoLienKetPayOSAsync();
                else _thanhToanVuaLap = null;
                _dsFile.Clear(); XoaBaoGia(); _ghiChu = "";
            }
            else _loi = (await res.Content.ReadFromJsonAsync<ApiError>()).Message;
        }
        catch { _loi = "Không lập được đơn tại quầy."; }
        _dangGui = false;
    }

    private async Task TaiLaiThanhToanAsync()
    {
        if (_maDonVuaLap == null) return;
        try
        {
            var res = await Http.GetAsync("api/thanh-toan/" + _maDonVuaLap);
            if (res.IsSuccessStatusCode) _thanhToanVuaLap = await res.Content.ReadFromJsonAsync<ThanhToanDto>();
            else _loi = (await res.Content.ReadFromJsonAsync<ApiError>()).Message;
        }
        catch { _loi = "Không tải được trạng thái thanh toán payOS."; }
    }

    private async Task TaoLienKetPayOSAsync()
    {
        if (_maDonVuaLap == null) return;
        _loi = null;
        try
        {
            var res = await Http.PostAsync("api/thanh-toan/" + _maDonVuaLap + "/payos", null);
            if (res.IsSuccessStatusCode)
                _lienKetPayOS = await res.Content.ReadFromJsonAsync<LienKetPayOSDto>();
            else
                _loi = (await res.Content.ReadFromJsonAsync<ApiError>()).Message;
        }
        catch { _loi = "Không tạo được mã QR payOS."; }
        await TaiLaiThanhToanAsync();
    }

    private static readonly System.Globalization.NumberFormatInfo KieuSoVietNam = new() { NumberGroupSeparator = ".", NumberDecimalSeparator = "," };
    private string Tien(decimal so) => so.ToString("#,##0", KieuSoVietNam) + "₫";
}
