@page "/nhan-vien"
@attribute [Authorize(Roles = "SUPER_ADMIN,BRANCH_ADMIN")]
@inject HttpClient Http
@inject PhienDangNhap Phien
@inject PhamViChiNhanh PhamVi
@inject IJSRuntime JS

<PageTitle>Nhân viên · PhotocopyChain</PageTitle>

@* F-24 (phần danh sách) + F-04: nhân viên quên mật khẩu thì cấp trên cấp mật khẩu tạm.
   Tạo / khóa tài khoản nhân viên làm ở Tuần 3. *@
<TieuDeTrang TieuDe="Nhân viên" MoTa="@MoTa()" />

<div class="than-trang khoi-doc">
    @if (_ketQua != null)
    {
        <div class="the the-mat-khau">
            <div class="mkt-dau">
                <span class="o-dung">@((MarkupString)Svg.DauTich(18))</span>
                <b>Mật khẩu tạm của @_tenVuaCap</b>
                <button class="nut-dong" title="Đóng" @onclick="() => _ketQua = null">✕</button>
            </div>
            <div class="mkt-than">
                <span class="mk-tam">@_ketQua.MatKhauTam</span>
                <button class="nut-nho" @onclick="ChepAsync">@(_daChep ? "Đã chép" : "Chép")</button>
            </div>
            <p class="the-mo-ta nho">@_ketQua.Message</p>
        </div>
    }

    @if (_loi != null)
    {
        <div class="o-loi">@((MarkupString)Svg.ChamThan())<span>@_loi</span></div>
    }

    <div class="the the-rong">
        <h2 class="the-tieu-de nho">Tạo tài khoản nhân viên mới</h2>
        <div class="ca-loc-luoi">
            <div class="truong"><label class="nhan">Họ tên</label><input class="ca-o-loc" placeholder="VD: Nguyễn Văn B" @bind="_tao.HoTen" /></div>
            <div class="truong"><label class="nhan">Email</label><input class="ca-o-loc" type="email" placeholder="nv@photocopy.vn" @bind="_tao.Email" /></div>
            <div class="truong"><label class="nhan">Số điện thoại</label><input class="ca-o-loc" placeholder="09xxxxxxxx" @bind="_tao.SoDienThoai" /></div>
            <div class="truong">
                <label class="nhan">Vai trò</label>
                <select class="ca-o-loc" @bind="_tao.VaiTro">
                    @if (Phien.NguoiDung?.TenVaiTro == "SUPER_ADMIN")
                    {
                        <option value="BRANCH_ADMIN">Quản lý chi nhánh (BRANCH_ADMIN)</option>
                    }
                    <option value="STAFF">Nhân viên in ấn (STAFF)</option>
                    <option value="SHIPPER">Nhân viên giao nhận (SHIPPER)</option>
                </select>
            </div>
            @if (Phien.NguoiDung?.TenVaiTro == "SUPER_ADMIN")
            {
                <div class="truong">
                    <label class="nhan">Chi nhánh công tác</label>
                    <select class="ca-o-loc" disabled="@(PhamVi.MaChiNhanh != null)" @bind="_tao.MaChiNhanh">
                        @foreach (ChiNhanhDto c in _chiNhanh)
                        {
                            <option value="@c.MaChiNhanh">@c.TenChiNhanh</option>
                        }
                    </select>
                </div>
            }
            <div class="truong"><label class="nhan">Mật khẩu ban đầu</label><input class="ca-o-loc" type="password" placeholder="••••••••" @bind="_tao.MatKhau" /></div>
        </div>
        <div style="margin-top: 14px;">
            <button class="nut-chinh" disabled="@_dangCap" @onclick="TaoNhanVienAsync">
                @(_dangCap ? "Đang tạo…" : "Tạo nhân viên")
            </button>
        </div>
    </div>

    <div class="the the-bang">
        <div class="bang-tieu-de">
            <div>
                <h2>Danh sách nhân viên</h2>
                <p class="bang-mo-ta">Tài khoản, vai trò và chi nhánh công tác của nhân viên.</p>
            </div>
            <span class="bang-dem">@(_ds == null ? 0 : LocDanhSach().Count) nhân viên</span>
        </div>
        <div class="bang-cong-cu">
            <div class="o-nhap nho o-tim">
                <span class="o-icon">@((MarkupString)Svg.KinhLup())</span>
                <input placeholder="Tìm tên, email, số điện thoại" @bind="_tuKhoa" @bind:event="oninput" />
            </div>
        </div>
        @if (_ds == null)
        {
            <div class="bang-trong">Đang tải danh sách nhân viên…</div>
        }
        else if (LocDanhSach().Count == 0)
        {
            <div class="bang-trong">Không tìm thấy nhân viên phù hợp.</div>
        }
        else
        {
            <div class="bang-cuon">
                <table role="table" class="bang">
                    <thead>
                        <tr>
                            <th scope="col">Nhân viên</th>
                            <th scope="col">Vai trò</th>
                            <th scope="col">Chi nhánh</th>
                            <th scope="col">Trạng thái</th>
                            <th scope="col">Ngày tạo</th>
                            <th scope="col"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var nv in LocDanhSach())
                        {
                            <tr>
                                <td data-nhan="Nhân viên">
                                    <div class="nv-o">
                                        <div class="avatar-nho">@VietTat(nv.HoTen)</div>
                                        <div>
                                            <div class="nv-ten">@nv.HoTen @(LaChinhMinh(nv) ? "(bạn)" : "")</div>
                                            <div class="nv-phu">@nv.Email@(nv.SoDienThoai == null ? "" : " · " + nv.SoDienThoai)</div>
                                        </div>
                                    </div>
                                </td>
                                <td data-nhan="Vai trò"><span class="nhan-mau nhan-accent mono">@nv.TenVaiTro</span></td>
                                <td data-nhan="Chi nhánh">@(nv.TenChiNhanh ?? "Toàn chuỗi")</td>
                                <td data-nhan="Trạng thái">
                                    @if (nv.TrangThai == "KHOA")
                                    {
                                        <span class="nhan-mau nhan-do">Bị khóa</span>
                                    }
                                    else
                                    {
                                        <span class="nhan-mau nhan-xanh">Đang làm</span>
                                    }
                                </td>
                                <td data-nhan="Ngày tạo">
                                    <span class="chu-mo">@nv.NgayTao.ToString("dd/MM/yyyy")</span>
                                </td>
                                <td class="cot-hanh-dong" data-nhan="Thao tác">
                                    @if (!nv.DuocCapLai)
                                    {
                                        <span class="chu-mo">@LyDoKhongCapLai(nv)</span>
                                    }
                                    else if (_dangXacNhan == nv.MaNguoiDung)
                                    {
                                        <div class="xac-nhan-o">
                                            <span class="chu-mo">Cấp mật khẩu tạm mới?</span>
                                            <button class="nut-nho chinh" disabled="@_dangCap" @onclick="() => CapLaiAsync(nv)">@(_dangCap ? "Đang cấp…" : "Xác nhận")</button>
                                            <button class="nut-nho" disabled="@_dangCap" @onclick="() => _dangXacNhan = null">Hủy</button>
                                        </div>
                                    }
                                    else
                                    {
                                        <button class="nut-nho" @onclick="() => _dangXacNhan = nv.MaNguoiDung">@((MarkupString)Svg.Khoa(13)) Cấp lại mật khẩu</button>
                                    }
                                    @if (DuocDoiTrangThai(nv))
                                    {
                                        @if (nv.TrangThai == "KHOA")
                                        {
                                            <button class="nut-nho" title="Mở khóa tài khoản nhân viên" @onclick="() => DoiTrangThaiAsync(nv)">Mở khóa</button>
                                        }
                                        else
                                        {
                                            <button class="nut-nho nguy-hiem" title="Khóa tài khoản này" @onclick="() => DoiTrangThaiAsync(nv)">Khóa</button>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="the ghi-chu-quy-tac">
        <h2 class="the-tieu-de nho">Ai cấp lại mật khẩu cho ai?</h2>
        <ul>
            <li><b>Quản lý chi nhánh</b> cấp lại cho <span class="mono">STAFF</span> và <span class="mono">SHIPPER</span> thuộc chi nhánh mình.</li>
            <li>Tài khoản <b>Quản lý chi nhánh</b> chỉ <b>Super Admin</b> cấp lại — quản lý không cấp cho người cùng cấp.</li>
            <li><b>Super Admin</b> và <b>khách hàng</b> tự khôi phục bằng mã OTP gửi qua email.</li>
            <li>Mật khẩu tạm chỉ hiện một lần; CSDL chỉ lưu bản băm. Nhân viên nên đổi sang mật khẩu riêng ngay sau khi đăng nhập.</li>
        </ul>
    </div>
</div>

@code {
    private List<NhanVienDto> _ds;              // danh sách lấy từ API (null = đang tải)
    private string _tuKhoa = "";                // ô tìm kiếm
    private string _loi;
    private int? _dangXacNhan;                  // mã nhân viên đang hiện nút "Xác nhận / Hủy"
    private bool _dangCap = false;
    private CapLaiMatKhauKetQuaDto _ketQua;     // mật khẩu tạm vừa cấp (hiện 1 lần)
    private string _tenVuaCap;
    private bool _daChep = false;
    private TaoNhanVienRequest _tao = new() { VaiTro = "STAFF", MatKhau = "Nhanvien2026" };
    private List<ChiNhanhDto> _chiNhanh = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _chiNhanh = await Http.GetFromJsonAsync<List<ChiNhanhDto>>("api/danh-muc/chi-nhanh") ?? new();
            if (_chiNhanh.Count > 0) _tao.MaChiNhanh = PhamVi.MaChiNhanh ?? _chiNhanh[0].MaChiNhanh;
        }
        catch { }
        await TaiDanhSach();
    }

    private async Task TaoNhanVienAsync()
    {
        _loi = null; _dangCap = true;
        var res = await Http.PostAsJsonAsync("api/nhan-vien", _tao);
        if (res.IsSuccessStatusCode)
        {
            _tao = new TaoNhanVienRequest { VaiTro = "STAFF", MatKhau = "Nhanvien2026", MaChiNhanh = PhamVi.MaChiNhanh ?? _chiNhanh.FirstOrDefault()?.MaChiNhanh };
            await TaiDanhSach();
        }
        else _loi = (await res.Content.ReadFromJsonAsync<ApiError>()).Message;
        _dangCap = false;
    }

    private bool DuocDoiTrangThai(NhanVienDto nv)
    {
        if (LaChinhMinh(nv) || nv.TenVaiTro == "SUPER_ADMIN") return false;
        if (Phien.NguoiDung?.TenVaiTro == "SUPER_ADMIN") return true;
        return nv.TenVaiTro == "STAFF" || nv.TenVaiTro == "SHIPPER";
    }

    private async Task DoiTrangThaiAsync(NhanVienDto nv)
    {
        string moi = nv.TrangThai == "KHOA" ? "HOAT_DONG" : "KHOA";
        var res = await Http.PutAsJsonAsync("api/nhan-vien/" + nv.MaNguoiDung + "/trang-thai", new CapNhatTrangThaiRequest { TrangThai = moi });
        if (res.IsSuccessStatusCode) await TaiDanhSach();
        else _loi = (await res.Content.ReadFromJsonAsync<ApiError>()).Message;
    }

    // GET api/nhan-vien — API tự lọc: Super Admin thấy toàn chuỗi, Quản lý CN chỉ thấy chi nhánh mình
    private async Task TaiDanhSach()
    {
        try
        {
            var res = await Http.GetAsync("api/nhan-vien");
            if (res.IsSuccessStatusCode)
            {
                _ds = await res.Content.ReadFromJsonAsync<List<NhanVienDto>>();
            }
            else
            {
                var loi = await res.Content.ReadFromJsonAsync<ApiError>();
                _loi = loi.Message;
                _ds = new List<NhanVienDto>();
            }
        }
        catch
        {
            _loi = "Không kết nối được máy chủ API. Kiểm tra PhotocopyApi đã chạy chưa.";
            _ds = new List<NhanVienDto>();
        }
    }

    // Lọc theo ô tìm kiếm (tên, email, số điện thoại)
    private List<NhanVienDto> LocDanhSach()
    {
        var ketQua = new List<NhanVienDto>();
        if (_ds == null) return ketQua;

        string tuKhoa = _tuKhoa.Trim().ToLower();
        foreach (var nv in _ds)
        {
            string sdt = nv.SoDienThoai ?? "";
            if (tuKhoa == "" || nv.HoTen.ToLower().Contains(tuKhoa) || nv.Email.ToLower().Contains(tuKhoa) || sdt.Contains(tuKhoa))
                ketQua.Add(nv);
        }
        return ketQua;
    }

    // POST api/nhan-vien/{id}/cap-lai-mat-khau — thủ tục sp_CapLaiMatKhau kiểm tra ai được cấp cho ai
    private async Task CapLaiAsync(NhanVienDto nv)
    {
        _loi = null;
        _dangCap = true;
        try
        {
            var res = await Http.PostAsync("api/nhan-vien/" + nv.MaNguoiDung + "/cap-lai-mat-khau", null);
            if (res.IsSuccessStatusCode)
            {
                _ketQua = await res.Content.ReadFromJsonAsync<CapLaiMatKhauKetQuaDto>();
                _tenVuaCap = nv.HoTen;
                _daChep = false;
                _dangXacNhan = null;
                await TaiDanhSach();
            }
            else
            {
                var loi = await res.Content.ReadFromJsonAsync<ApiError>();
                _loi = loi.Message;
            }
        }
        catch
        {
            _loi = "Không kết nối được máy chủ API. Kiểm tra PhotocopyApi đã chạy chưa.";
        }
        _dangCap = false;
    }

    // Chép mật khẩu tạm vào bộ nhớ tạm của máy (gọi hàm JavaScript của trình duyệt)
    private async Task ChepAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _ketQua.MatKhauTam);
            _daChep = true;
        }
        catch
        {
            // trình duyệt chặn chép thì thôi — vẫn đọc được trên màn hình
        }
    }

    private string MoTa()
    {
        if (Phien.NguoiDung != null && Phien.NguoiDung.TenVaiTro == "SUPER_ADMIN")
            return (PhamVi.MaChiNhanh == null ? "Toàn chuỗi" : "Chi nhánh đang chọn") + " · cấp lại mật khẩu cho nhân viên quên mật khẩu";
        return Phien.NguoiDung?.TenChiNhanh + " · cấp lại mật khẩu cho nhân viên quên mật khẩu";
    }

    private bool LaChinhMinh(NhanVienDto nv)
    {
        return Phien.NguoiDung != null && nv.MaNguoiDung == Phien.NguoiDung.MaNguoiDung;
    }

    // Dòng nào không có nút "Cấp lại mật khẩu" thì ghi lý do
    private string LyDoKhongCapLai(NhanVienDto nv)
    {
        if (LaChinhMinh(nv)) return "Tự đổi ở Thông tin cá nhân";
        if (nv.TrangThai == "KHOA") return "Tài khoản đã khóa";
        if (nv.TenVaiTro == "SUPER_ADMIN") return "Tự khôi phục qua OTP email";
        if (nv.TenVaiTro == "BRANCH_ADMIN") return "Chỉ Super Admin cấp lại";
        return "Ngoài phạm vi chi nhánh";
    }

    // "Phạm Văn Thợ" → "VT"
    private string VietTat(string hoTen)
    {
        if (string.IsNullOrWhiteSpace(hoTen)) return "?";
        string[] tu = hoTen.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (tu.Length == 1) return tu[0].Substring(0, 1).ToUpper();
        return (tu[tu.Length - 2].Substring(0, 1) + tu[tu.Length - 1].Substring(0, 1)).ToUpper();
    }
}
