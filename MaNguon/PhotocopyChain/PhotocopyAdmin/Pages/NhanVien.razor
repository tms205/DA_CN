@page "/nhan-vien"
@attribute [Authorize(Roles = "SUPER_ADMIN,BRANCH_ADMIN")]
@inject HttpClient Http
@inject PhienDangNhap Phien
@inject PhamViChiNhanh PhamVi

<PageTitle>Nhân viên · PhotocopyChain</PageTitle>

@* Quản lý danh sách, tạo và khóa/mở khóa nhân viên theo phân quyền hiện có. *@
<TieuDeTrang TieuDe="Nhân viên" MoTa="@MoTa()" />

<div class="than-trang khoi-doc">
    @if (_loi != null && !_moTao)
    {
        <div class="o-loi">@((MarkupString)Svg.ChamThan())<span>@_loi</span></div>
    }

    <button type="button" class="nut-chinh" disabled="@_dangCap" @onclick="MoTao">Thêm nhân viên</button>
    <HopThoaiQuanTri Mo="@_moTao" TieuDe="Tạo tài khoản nhân viên mới" Loi="@_loi" DangLuu="@_dangCap" Dong="DongTao" Rong="true">
    <NoiDung>
    <form id="nv-form-tao" @onsubmit="TaoNhanVienAsync" @onsubmit:preventDefault>
        <div class="ca-loc-luoi">
            <div class="truong"><label class="nhan" for="nv-ten">Họ tên</label><input id="nv-ten" required maxlength="100" class="ca-o-loc" placeholder="VD: Nguyễn Văn B" @bind="_tao.HoTen" /></div>
            <div class="truong"><label class="nhan" for="nv-email">Email</label><input id="nv-email" required maxlength="100" class="ca-o-loc" type="email" placeholder="nhanvien@gmail.com" @bind="_tao.Email" /></div>
            <div class="truong"><label class="nhan" for="nv-sdt">Số điện thoại</label><input id="nv-sdt" inputmode="numeric" pattern="0[0-9]{9}" title="10 chữ số, bắt đầu bằng 0" maxlength="10" class="ca-o-loc" placeholder="09xxxxxxxx" @bind="_tao.SoDienThoai" /></div>
            <div class="truong">
                <label class="nhan" for="nv-vai-tro">Vai trò</label>
                <select id="nv-vai-tro" class="ca-o-loc" @bind="_tao.VaiTro">
                    @if (Phien.NguoiDung?.TenVaiTro == "SUPER_ADMIN")
                    {
                        <option value="BRANCH_ADMIN">Quản lý chi nhánh (BRANCH_ADMIN)</option>
                    }
                    <option value="STAFF">Nhân viên in ấn (STAFF)</option>
                    <option value="SHIPPER">Nhân viên giao nhận (SHIPPER)</option>
                </select>
            </div>
            @if (Phien.NguoiDung?.TenVaiTro == "SUPER_ADMIN")
            {
                <div class="truong">
                    <label class="nhan" for="nv-cn">Chi nhánh công tác</label>
                    <select id="nv-cn" class="ca-o-loc" disabled="@(PhamVi.MaChiNhanh != null)" @bind="_tao.MaChiNhanh">
                        @foreach (ChiNhanhDto c in _chiNhanh)
                        {
                            <option value="@c.MaChiNhanh">@c.TenChiNhanh</option>
                        }
                    </select>
                </div>
            }
            <div class="truong"><label class="nhan" for="nv-mk">Mật khẩu ban đầu</label><input id="nv-mk" required maxlength="72" class="ca-o-loc" type="password" autocomplete="new-password" placeholder="••••••••" @bind="_tao.MatKhau" /></div>
        </div>
    </form>
    </NoiDung>
    <Chan><button type="button" class="nut-phu" disabled="@_dangCap" @onclick="DongTao">Hủy</button><button type="submit" form="nv-form-tao" class="nut-chinh" disabled="@_dangCap">@(_dangCap ? "Đang tạo…" : "Tạo nhân viên")</button></Chan>
    </HopThoaiQuanTri>
    <XacNhanThaoTac @ref="_xacNhan" />

    <div class="the the-bang">
        <div class="bang-tieu-de">
            <div>
                <h2>Danh sách nhân viên</h2>
                <p class="bang-mo-ta">Tài khoản, vai trò và chi nhánh công tác của nhân viên.</p>
            </div>
            <span class="bang-dem">@(_ds == null ? 0 : LocDanhSach().Count) nhân viên</span>
        </div>
        <div class="bang-cong-cu">
            <div class="o-nhap nho o-tim">
                <span class="o-icon">@((MarkupString)Svg.KinhLup())</span>
                <input placeholder="Tìm tên, email, số điện thoại" @bind="_tuKhoa" @bind:event="oninput" />
            </div>
        </div>
        @if (_ds == null)
        {
            <div class="bang-trong">Đang tải danh sách nhân viên…</div>
        }
        else if (LocDanhSach().Count == 0)
        {
            <div class="bang-trong">Không tìm thấy nhân viên phù hợp.</div>
        }
        else
        {
            <div class="bang-cuon">
                <table role="table" class="bang bang-thao-tac-trai">
                    <thead>
                        <tr>
                            <th scope="col">Nhân viên</th>
                            <th scope="col">Vai trò</th>
                            <th scope="col">Chi nhánh</th>
                            <th scope="col">Trạng thái</th>
                            <th scope="col">Ngày tạo</th>
                            <th scope="col" class="cot-hanh-dong">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var nv in LocDanhSach())
                        {
                            <tr>
                                <td data-nhan="Nhân viên">
                                    <div class="nv-o">
                                        <div class="avatar-nho">@VietTat(nv.HoTen)</div>
                                        <div>
                                            <div class="nv-ten">@nv.HoTen @(LaChinhMinh(nv) ? "(bạn)" : "")</div>
                                            <div class="nv-phu">@nv.Email@(nv.SoDienThoai == null ? "" : " · " + nv.SoDienThoai)</div>
                                        </div>
                                    </div>
                                </td>
                                <td data-nhan="Vai trò"><span class="nhan-mau nhan-accent mono">@nv.TenVaiTro</span></td>
                                <td data-nhan="Chi nhánh">@(nv.TenChiNhanh ?? "Toàn chuỗi")</td>
                                <td data-nhan="Trạng thái">
                                    @if (nv.TrangThai == "KHOA")
                                    {
                                        <span class="nhan-mau nhan-do">Bị khóa</span>
                                    }
                                    else
                                    {
                                        <span class="nhan-mau nhan-xanh">Đang làm</span>
                                    }
                                </td>
                                <td data-nhan="Ngày tạo">
                                    <span class="chu-mo">@nv.NgayTao.ToString("dd/MM/yyyy")</span>
                                </td>
                                <td class="cot-hanh-dong" data-nhan="Thao tác">
                                    @if (DuocDoiTrangThai(nv))
                                    {
                                        @if (nv.TrangThai == "KHOA")
                                        {
                                            <button class="nut-nho" disabled="@_dangCap" title="Mở khóa tài khoản nhân viên" @onclick="() => DoiTrangThaiAsync(nv)">Mở khóa</button>
                                        }
                                        else
                                        {
                                            <button class="nut-nho nguy-hiem" disabled="@_dangCap" title="Khóa tài khoản này" @onclick="() => DoiTrangThaiAsync(nv)">Khóa</button>
                                        }
                                    }
                                    else
                                    {
                                        <span class="chu-mo">@(LaChinhMinh(nv) ? "Tài khoản của bạn" : "Không có thao tác")</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="the ghi-chu-quy-tac">
        <h2 class="the-tieu-de nho">Đổi và khôi phục mật khẩu</h2>
        <ul>
            <li>Nhân viên tự đổi mật khẩu tại <b>Thông tin cá nhân</b>.</li>
            <li>Khi quên mật khẩu, dùng chức năng <b>Quên mật khẩu</b> ở trang đăng nhập để nhận mã OTP qua email đã đăng ký.</li>
        </ul>
    </div>
</div>

@code {
    private List<NhanVienDto> _ds;              // danh sách lấy từ API (null = đang tải)
    private string _tuKhoa = "";                // ô tìm kiếm
    private string _loi;
    private bool _moTao;
    private XacNhanThaoTac _xacNhan;
    private void MoTao() { if (_dangCap) return; _tao = new() { VaiTro = "STAFF", MaChiNhanh = PhamVi.MaChiNhanh ?? _chiNhanh.FirstOrDefault()?.MaChiNhanh }; _loi = null; _moTao = true; }
    private void DongTao() { if (!_dangCap) { _moTao = false; _tao.MatKhau = ""; _loi = null; } }
    private bool _dangCap = false;
    private TaoNhanVienRequest _tao = new() { VaiTro = "STAFF" };
    private List<ChiNhanhDto> _chiNhanh = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _chiNhanh = await Http.GetFromJsonAsync<List<ChiNhanhDto>>("api/danh-muc/chi-nhanh") ?? new();
            if (_chiNhanh.Count > 0) _tao.MaChiNhanh = PhamVi.MaChiNhanh ?? _chiNhanh[0].MaChiNhanh;
        }
        catch { }
        await TaiDanhSach();
    }

    private async Task TaoNhanVienAsync()
    {
        if (_dangCap) return;
        _tao.Email = _tao.Email.Trim();
        _loi = QuyTacNhap.LayLoi(_tao);
        if (_loi != null) return;
        _loi = null; _dangCap = true;
        try
        {
            using var res = await Http.PostAsJsonAsync("api/nhan-vien", _tao);
            if (!res.IsSuccessStatusCode) { _loi = await DocLoiApi.TuPhanHoiAsync(res, "Không tạo được nhân viên."); return; }
            _tao = new() { VaiTro = "STAFF", MaChiNhanh = PhamVi.MaChiNhanh ?? _chiNhanh.FirstOrDefault()?.MaChiNhanh };
            _moTao = false;
            await TaiDanhSach();
        }
        catch (HttpRequestException) { _loi = "Mất kết nối API. Làm mới danh sách trước khi thử lại."; }
        finally { _dangCap = false; }
    }

    private bool DuocDoiTrangThai(NhanVienDto nv)
    {
        if (LaChinhMinh(nv) || nv.TenVaiTro == "SUPER_ADMIN") return false;
        if (Phien.NguoiDung?.TenVaiTro == "SUPER_ADMIN") return true;
        return nv.TenVaiTro == "STAFF" || nv.TenVaiTro == "SHIPPER";
    }

    private async Task DoiTrangThaiAsync(NhanVienDto nv)
    {
        if (_dangCap || !DuocDoiTrangThai(nv)) return;
        string moi = nv.TrangThai == "KHOA" ? "HOAT_DONG" : "KHOA";
        if (!await _xacNhan.HoiAsync((moi == "KHOA" ? "Khóa" : "Mở khóa") + " tài khoản “" + nv.HoTen + "”? Không xóa lịch sử làm việc.", "Trạng thái nhân viên", "Xác nhận", moi == "KHOA")) return;
        _dangCap = true; _loi = null;
        try
        {
            using var res = await Http.PutAsJsonAsync("api/nhan-vien/" + nv.MaNguoiDung + "/trang-thai", new CapNhatTrangThaiRequest { TrangThai = moi });
            if (res.IsSuccessStatusCode) await TaiDanhSach();
            else _loi = await DocLoiApi.TuPhanHoiAsync(res, "Không đổi được trạng thái nhân viên.");
        }
        catch (HttpRequestException) { _loi = "Mất kết nối API. Làm mới danh sách để kiểm tra kết quả."; }
        finally { _dangCap = false; }
    }

    // GET api/nhan-vien — API tự lọc: Super Admin thấy toàn chuỗi, Quản lý CN chỉ thấy chi nhánh mình
    private async Task TaiDanhSach()
    {
        try
        {
            var res = await Http.GetAsync("api/nhan-vien");
            if (res.IsSuccessStatusCode)
            {
                _ds = await res.Content.ReadFromJsonAsync<List<NhanVienDto>>();
            }
            else
            {
                var loi = await res.Content.ReadFromJsonAsync<ApiError>();
                _loi = loi.Message;
                _ds = new List<NhanVienDto>();
            }
        }
        catch
        {
            _loi = "Không kết nối được máy chủ API. Kiểm tra PhotocopyApi đã chạy chưa.";
            _ds = new List<NhanVienDto>();
        }
    }

    // Lọc theo ô tìm kiếm (tên, email, số điện thoại)
    private List<NhanVienDto> LocDanhSach()
    {
        var ketQua = new List<NhanVienDto>();
        if (_ds == null) return ketQua;

        string tuKhoa = _tuKhoa.Trim().ToLower();
        foreach (var nv in _ds)
        {
            string sdt = nv.SoDienThoai ?? "";
            if (tuKhoa == "" || nv.HoTen.ToLower().Contains(tuKhoa) || nv.Email.ToLower().Contains(tuKhoa) || sdt.Contains(tuKhoa))
                ketQua.Add(nv);
        }
        return ketQua;
    }

    private string MoTa()
    {
        if (Phien.NguoiDung != null && Phien.NguoiDung.TenVaiTro == "SUPER_ADMIN")
            return (PhamVi.MaChiNhanh == null ? "Toàn chuỗi" : "Chi nhánh đang chọn") + " · quản lý tài khoản và trạng thái nhân viên";
        return Phien.NguoiDung?.TenChiNhanh + " · quản lý tài khoản và trạng thái nhân viên";
    }

    private bool LaChinhMinh(NhanVienDto nv)
    {
        return Phien.NguoiDung != null && nv.MaNguoiDung == Phien.NguoiDung.MaNguoiDung;
    }

    // "Phạm Văn Thợ" → "VT"
    private string VietTat(string hoTen)
    {
        if (string.IsNullOrWhiteSpace(hoTen)) return "?";
        string[] tu = hoTen.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (tu.Length == 1) return tu[0].Substring(0, 1).ToUpper();
        return (tu[tu.Length - 2].Substring(0, 1) + tu[tu.Length - 1].Substring(0, 1)).ToUpper();
    }
}
