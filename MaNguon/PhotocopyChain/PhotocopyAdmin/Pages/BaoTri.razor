@page "/bao-tri"
@attribute [Authorize(Roles = "SUPER_ADMIN")]
@inject HttpClient Http
<PageTitle>Bảo trì hệ thống · PhotocopyChain</PageTitle>
<TieuDeTrang TieuDe="Bảo trì hệ thống" MoTa="Quản lý quyền truy cập trong thời gian nâng cấp." />
<div class="than-trang bt-page">
    @if (_state == null)
    {
        <section class="bt-card bt-loading" role="status">
            @if (_error == null) { <p>Đang kiểm tra trạng thái hệ thống…</p> }
            else { <p>@_error</p><button type="button" class="bt-secondary" @onclick="TaiTrangThai">Thử lại</button> }
        </section>
    }
    else
    {
        <section class="bt-status bt-card" aria-labelledby="bt-status-title">
            <div class="bt-status-icon @(_state.DangBaoTri ? "is-maintenance" : "is-online")" aria-hidden="true">@((MarkupString)(_state.DangBaoTri ? Svg.BaoTri(24) : Svg.DauTich(24)))</div>
            <div class="bt-status-copy">
                <div class="bt-eyebrow">TRẠNG THÁI HỆ THỐNG</div>
                <h2 id="bt-status-title">@(_state.DangBaoTri ? "Đang bảo trì" : "Đang hoạt động")</h2>
                <p>@(_state.DangBaoTri ? "Đang áp dụng các phạm vi khóa đã chọn. Chức năng ngoài phạm vi vẫn hoạt động." : "Người dùng có thể đăng nhập và sử dụng hệ thống bình thường.")</p>
                @if(_state.DangBaoTri && _state.KetThucLuc!=null) { <p><b>Tự mở lại: @Gio(_state.KetThucLuc.Value)</b></p> }
            </div>
            <span class="bt-pill @(_state.DangBaoTri ? "is-maintenance" : "is-online")"><span aria-hidden="true"></span>@(_state.DangBaoTri ? "Đang bật" : "Đang tắt")</span>
        </section>

        <div class="bt-grid">
            <section class="bt-card bt-main" aria-labelledby="bt-message-title">
                <h2>Thời gian và phạm vi bảo trì</h2>
                <p>Giờ máy chủ khi tải: @Gio(_gioHeThong). Thời gian bắt đầu/kết thúc được chốt tại máy chủ khi lưu.</p>
                <label class="bt-label" for="bt-so-gio">Thời lượng bảo trì (giờ)</label>
                <input id="bt-so-gio" class="ca-o-loc" type="number" min="0.25" max="168" step="0.25" @bind="_soGio" disabled="@_busy" />
                <p>Dự kiến mở lại: @Gio(_gioHeThong.AddHours(double.IsFinite(_soGio)&&_soGio is >=0.25 and <=168?_soGio:2))</p>
                <div class="bt-pham-vi">
                    <fieldset disabled="@_busy"><legend>Web quản trị</legend>
                        <label><input type="checkbox" @bind="_khoaWeb" /> Khóa toàn bộ Web (đăng xuất nhân sự)</label>
                        @foreach(var f in DanhMucBaoTri.Web) { <label><input type="checkbox" disabled="@_khoaWeb" checked="@_web.Contains(f.Key)" @onchange="e=>Chon(_web,f.Key,e)" /> @f.Value</label> }
                    </fieldset>
                    <fieldset disabled="@_busy"><legend>App điện thoại</legend>
                        <label><input type="checkbox" @bind="_khoaApp" /> Khóa toàn bộ App (đăng xuất khách/shipper)</label>
                        @foreach(var f in DanhMucBaoTri.App) { <label><input type="checkbox" disabled="@_khoaApp" checked="@_app.Contains(f.Key)" @onchange="e=>Chon(_app,f.Key,e)" /> @f.Value</label> }
                    </fieldset>
                </div>
                <div class="bt-section-head"><div><h2 id="bt-message-title">Lời nhắn cho người dùng</h2><p>Thông báo hiển thị khi người dùng truy cập phạm vi đang bảo trì.</p></div></div>
                <label class="bt-label" for="loi-nhan-bao-tri">Nội dung thông báo <span aria-label="bắt buộc">*</span></label>
                <textarea id="loi-nhan-bao-tri" rows="5" maxlength="500" @bind="_message" @bind:event="oninput" disabled="@_busy" placeholder="Ví dụ: Hệ thống đang nâng cấp. Vui lòng quay lại sau."></textarea>
                <div class="bt-count">@(_message?.Length ?? 0) / 500 ký tự</div>
                <div class="bt-preview"><span class="bt-preview-label">XEM TRƯỚC THÔNG BÁO</span><strong>@(_khoaWeb||_khoaApp?"Hệ thống đang bảo trì":"Chức năng đang bảo trì")</strong><p>@(string.IsNullOrWhiteSpace(_message) ? "Lời nhắn của bạn sẽ xuất hiện tại đây." : _message)</p><p>Dự kiến mở lại: @Gio(_gioHeThong.AddHours(double.IsFinite(_soGio)&&_soGio is >=0.25 and <=168?_soGio:2))</p></div>
                @if (_error != null) { <ThongBaoLoi @bind-NoiDung="_error" /> }
                @if (_notice != null) { <div class="bt-success" role="status">@_notice</div> }
                <div class="bt-actions">
                    @if (_state.DangBaoTri)
                    {
                        <button type="button" class="bt-primary" disabled="@_busy" @onclick="XacNhanBat">Lưu cấu hình bảo trì</button>
                        <button type="button" class="bt-secondary" disabled="@_busy" @onclick="() => Luu(false)">Tắt bảo trì</button>
                    }
                    else
                    {
                        <button type="button" class="bt-primary" disabled="@_busy" @onclick="XacNhanBat">Bật bảo trì</button>
                    }
                </div>
            </section>
            <aside class="bt-card bt-info" aria-labelledby="bt-info-title">
                <div class="bt-info-icon" aria-hidden="true">@((MarkupString)Svg.ThongTin(19))</div>
                <h2 id="bt-info-title">Trước khi bật bảo trì</h2>
                <ol>
                    <li>Chờ các giao dịch thuộc phạm vi bảo trì hoàn tất.</li>
                    <li>Khóa toàn nền tảng: người dùng nền tảng đó bị đăng xuất. Khóa chức năng: giữ phiên, chỉ chặn thao tác liên quan.</li>
                    <li>Nếu Web bị khóa toàn bộ, CEO chỉ được quản lý bảo trì. Hết hạn hệ thống tự mở lại; phiên cũ đã bị thu hồi không dùng lại được.</li>
                </ol>
                <div class="bt-warning"><strong>Lưu ý về giao dịch</strong><p>Khóa toàn bộ cả Web và App sẽ chặn connector và callback thanh toán. Với bảo trì từng phần, callback đang có vẫn được ghi nhận. Kiểm tra, đối soát giao dịch sau khi mở lại.</p></div>
            </aside>
        </div>
    }
</div>
@if (_confirm)
{
    <div class="bt-overlay">
        <section class="bt-dialog" role="alertdialog" aria-modal="true" aria-labelledby="bt-confirm-title" aria-describedby="bt-confirm-desc" @onkeydown="PhimXacNhan">
            <div class="bt-dialog-icon" aria-hidden="true">@((MarkupString)Svg.CanhBao(24))</div>
            <h2 id="bt-confirm-title">Bật chế độ bảo trì?</h2>
            <p id="bt-confirm-desc">Áp dụng phạm vi và thời lượng đã chọn tính từ giờ máy chủ khi lưu. Người dùng chỉ bị đăng xuất nếu nền tảng bị khóa toàn bộ. Hãy chắc chắn các giao dịch liên quan đã hoàn tất.</p>
            <div class="bt-dialog-actions"><button type="button" class="bt-secondary" autofocus disabled="@_busy" @onclick="() => _confirm = false">Quay lại</button><button type="button" class="bt-primary" disabled="@_busy" @onclick="() => Luu(true)">@(_busy ? "Đang cập nhật…" : "Xác nhận bật")</button></div>
        </section>
    </div>
}
@code {
    private TrangThai _state;
    private string _message = "", _error, _notice;
    private bool _busy, _confirm;
    private bool _khoaWeb=true,_khoaApp=true;
    private double _soGio=2;
    private DateTimeOffset _gioHeThong=DateTimeOffset.UtcNow;
    private HashSet<string> _web=new(),_app=new();
    private static string Gio(DateTimeOffset time)=>time.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm",System.Globalization.CultureInfo.InvariantCulture);
    private static void Chon(HashSet<string> list,string key,ChangeEventArgs e){if(e.Value is true)list.Add(key);else list.Remove(key);}
    protected override Task OnInitializedAsync() => TaiTrangThai();
    private async Task TaiTrangThai()
    {
        _error = null;
        try { var config=await Http.GetFromJsonAsync<CauHinh>("api/bao-tri")??throw new InvalidOperationException();
            _state=config.TrangThai??config;_gioHeThong=config.GioHeThong==default?DateTimeOffset.UtcNow:config.GioHeThong;_message=_state.LoiNhan??"";
            _khoaWeb=_state.KhoaWeb;_khoaApp=_state.KhoaApp;_web=new(_state.KhoaTinhNangWeb??Array.Empty<string>());_app=new(_state.KhoaTinhNangApp??Array.Empty<string>());
            _web.IntersectWith(DanhMucBaoTri.Web.Keys);_app.IntersectWith(DanhMucBaoTri.App.Keys);
        }
        catch { _state = null; _error = "Không lấy được trạng thái bảo trì. Vui lòng thử lại."; }
    }
    private void XacNhanBat()
    {
        _error = null; _notice = null;
        if (string.IsNullOrWhiteSpace(_message)) { _error = "Vui lòng nhập lời nhắn cho người dùng."; return; }
        if(!double.IsFinite(_soGio)||_soGio<0.25||_soGio>168){_error="Thời lượng từ 0,25 đến 168 giờ.";return;}
        if(!_khoaWeb&&!_khoaApp&&_web.Count==0&&_app.Count==0){_error="Chọn phạm vi bảo trì.";return;}
        _confirm = true;
    }
    private void PhimXacNhan(KeyboardEventArgs e) { if (e.Key == "Escape" && !_busy) _confirm = false; }
    private async Task Luu(bool enabled)
    {
        _busy = true; _error = null; _notice = null;
        try {
            using var response = await Http.PutAsJsonAsync("api/bao-tri", new { dangBaoTri=enabled,loiNhan=_message,khoaWeb=_khoaWeb,khoaApp=_khoaApp,khoaTinhNangWeb=_web,khoaTinhNangApp=_app,soGio=_soGio });
            if (!response.IsSuccessStatusCode) { var err = await response.Content.ReadFromJsonAsync<ApiError>(); _error = err?.Message ?? "Không cập nhật được."; _confirm = false; return; }
            var updated=await response.Content.ReadFromJsonAsync<CauHinh>();_state=updated?.TrangThai;_gioHeThong=updated?.GioHeThong??_gioHeThong;
            if (_state == null) throw new InvalidOperationException();
            _confirm = false;
            _notice = enabled ? "Đã cập nhật chế độ bảo trì và lời nhắn." : "Đã tắt chế độ bảo trì.";
        } catch { _confirm = false; _error = "Không xác nhận được kết quả. Hãy tải lại trạng thái trước khi thao tác tiếp."; _state = null; }
        finally { _busy = false; }
    }
    private class TrangThai { public bool DangBaoTri {get;set;} public string LoiNhan {get;set;} public bool KhoaWeb {get;set;}=true;public bool KhoaApp {get;set;}=true;public string[] KhoaTinhNangWeb {get;set;}public string[] KhoaTinhNangApp {get;set;}public DateTimeOffset? KetThucLuc {get;set;} }
    private sealed class CauHinh:TrangThai {public TrangThai TrangThai {get;set;}public DateTimeOffset GioHeThong {get;set;}}
}
