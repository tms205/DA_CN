@page "/bao-cao"
@attribute [Authorize(Roles = "SUPER_ADMIN,BRANCH_ADMIN")]
@inject HttpClient Http

<PageTitle>Báo cáo doanh thu · PhotocopyChain</PageTitle>

<TieuDeTrang TieuDe="Báo cáo doanh thu" MoTa="Thống kê doanh thu thực tế ghi nhận từ các đơn hàng đã hoàn tất" />

<div class="than-trang khoi-doc">
    <div class="the ca-bo-loc">
        <div class="the-tieu-de nho">Bộ lọc thời gian & phạm vi thống kê</div>
        <div class="ca-loc-luoi">
            <div class="truong">
                <label class="nhan">Khoảng thời gian</label>
                <select class="ca-o-loc" value="@_khoangBaoCao" @onchange="DoiKhoangBaoCao">
                    <option value="ngay">Hôm nay</option>
                    <option value="tuan">Tuần này</option>
                    <option value="thang">Tháng này</option>
                    <option value="quy">Quý này</option>
                    <option value="nam">Năm nay</option>
                    <option value="tuy-chon">Tùy chọn ngày</option>
                </select>
            </div>
            <div class="truong">
                <label class="nhan">Từ ngày</label>
                <input class="ca-o-loc" type="date" @bind="_tuNgay" @bind:after="DanhDauKhoangTuyChon" />
            </div>
            <div class="truong">
                <label class="nhan">Đến ngày</label>
                <input class="ca-o-loc" type="date" @bind="_denNgay" @bind:after="DanhDauKhoangTuyChon" />
            </div>
            <div class="truong">
                <label class="nhan">Nhóm dữ liệu theo</label>
                <select class="ca-o-loc" @bind="_nhomTheo">
                    <option value="ngay">Theo từng ngày</option>
                    <option value="tuan">Theo tuần</option>
                    <option value="thang">Theo tháng</option>
                    <option value="quy">Theo quý</option>
                    <option value="nam">Theo năm</option>
                </select>
            </div>
            <div class="truong" style="align-self: flex-end;">
                <button class="nut-chinh" style="width: 100%;" disabled="@_dangTai" @onclick="TaiAsync">
                    @(_dangTai ? "Đang tải dữ liệu…" : "Xem báo cáo")
                </button>
            </div>
        </div>
    </div>

    @if (_loi != null)
    {
        <div class="o-loi">
            @((MarkupString)Svg.ChamThan())
            <span>@_loi</span>
        </div>
    }

    @if (_ds != null)
    {
        <div class="ca-so-lieu the-rong">
            <div class="ca-o ca-o-chinh">
                <div class="ca-o-nhan">Tổng doanh thu</div>
                <div class="ca-o-so mono">@Tien(_ds.Sum(x => x.DoanhThu))</div>
                <div class="nv-phu" style="margin-top: 4px;">Toàn bộ đơn hoàn thành trong kỳ</div>
            </div>
            <div class="ca-o">
                <div class="ca-o-nhan">Số đơn hoàn thành</div>
                <div class="ca-o-so mono">@_ds.Sum(x => x.SoDon)</div>
                <div class="nv-phu" style="margin-top: 4px;">Đơn hàng đã bàn giao thành công</div>
            </div>
            <div class="ca-o">
                <div class="ca-o-nhan">Doanh thu bình quân / đơn</div>
                <div class="ca-o-so mono">@Tien(_ds.Sum(x => x.SoDon) == 0 ? 0 : _ds.Sum(x => x.DoanhThu) / _ds.Sum(x => x.SoDon))</div>
                <div class="nv-phu" style="margin-top: 4px;">Giá trị trung bình mỗi đơn</div>
            </div>
        </div>

        <div class="the the-bang">
            <div class="bang-tieu-de">
                <div>
                    <h2>Chi tiết doanh thu theo kỳ đối chiếu</h2>
                    <p class="bang-mo-ta">Đối chiếu số đơn và số tiền theo từng kỳ báo cáo.</p>
                </div>
                <span class="bang-dem">@_ds.Count dòng</span>
            </div>
            @if (_ds.Count == 0)
            {
                <div class="bang-trong">Không có đơn hàng nào hoàn thành trong khoảng thời gian đã chọn.</div>
            }
            else
            {
                <div class="bang-cuon">
                    <table role="table" class="bang">
                        <thead>
                            <tr>
                                <th scope="col">@TieuDeCotKy()</th>
                                <th scope="col">Chi nhánh</th>
                                <th scope="col">Số lượng đơn</th>
                                <th scope="col">Doanh thu ghi nhận</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (BaoCaoDoanhThuDto x in _ds.OrderByDescending(x => x.Ngay).ThenBy(x => x.TenChiNhanh))
                            {
                                <tr>
                                    <td data-nhan="@TieuDeCotKy()"><b>@NhanKy(x.Ngay)</b></td>
                                    <td data-nhan="Chi nhánh">@x.TenChiNhanh</td>
                                    <td class="mono" data-nhan="Số lượng đơn"><b>@x.SoDon</b> đơn</td>
                                    <td class="mono hd-tong" data-nhan="Doanh thu ghi nhận">@Tien(x.DoanhThu)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
</div>
@code {
    private string _khoangBaoCao = "thang";
    private string _nhomTheo = "ngay";
    private DateTime _tuNgay = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime _denNgay = DateTime.Today;
    private List<BaoCaoDoanhThuDto> _ds;
    private string _loi;
    private bool _dangTai;

    protected override async Task OnInitializedAsync() => await TaiAsync();

    private void DoiKhoangBaoCao(ChangeEventArgs e)
    {
        _khoangBaoCao = e.Value?.ToString() ?? "tuy-chon";
        DateTime homNay = DateTime.Today;

        switch (_khoangBaoCao)
        {
            case "ngay":
                _tuNgay = homNay;
                _denNgay = homNay;
                break;
            case "tuan":
                int soNgayTuThuHai = ((int)homNay.DayOfWeek + 6) % 7;
                _tuNgay = homNay.AddDays(-soNgayTuThuHai);
                _denNgay = homNay;
                break;
            case "thang":
                _tuNgay = new DateTime(homNay.Year, homNay.Month, 1);
                _denNgay = homNay;
                break;
            case "quy":
                int thangDauQuy = ((homNay.Month - 1) / 3 * 3) + 1;
                _tuNgay = new DateTime(homNay.Year, thangDauQuy, 1);
                _denNgay = homNay;
                break;
            case "nam":
                _tuNgay = new DateTime(homNay.Year, 1, 1);
                _denNgay = homNay;
                break;
        }
    }

    private void DanhDauKhoangTuyChon() => _khoangBaoCao = "tuy-chon";

    private async Task TaiAsync()
    {
        _loi = null;
        _dangTai = true;
        try
        {
            string url = $"api/quan-tri/bao-cao/doanh-thu?tuNgay={_tuNgay:yyyy-MM-dd}&denNgay={_denNgay:yyyy-MM-dd}&nhomTheo={_nhomTheo}";
            var res = await Http.GetAsync(url);
            if (res.IsSuccessStatusCode)
                _ds = await res.Content.ReadFromJsonAsync<List<BaoCaoDoanhThuDto>>() ?? new();
            else
                _loi = (await res.Content.ReadFromJsonAsync<ApiError>()).Message;
        }
        catch
        {
            _loi = "Không tải được báo cáo.";
        }
        _dangTai = false;
    }

    private string TieuDeCotKy()
    {
        return _nhomTheo switch
        {
            "tuan" => "Tuần",
            "thang" => "Tháng",
            "quy" => "Quý",
            "nam" => "Năm",
            _ => "Ngày"
        };
    }

    private string NhanKy(DateTime ngayBatDau)
    {
        return _nhomTheo switch
        {
            "tuan" => $"{ngayBatDau:dd/MM/yyyy} – {ngayBatDau.AddDays(6):dd/MM/yyyy}",
            "thang" => $"Tháng {ngayBatDau:MM/yyyy}",
            "quy" => $"Quý {((ngayBatDau.Month - 1) / 3) + 1}/{ngayBatDau.Year}",
            "nam" => $"Năm {ngayBatDau.Year}",
            _ => ngayBatDau.ToString("dd/MM/yyyy")
        };
    }

    private static readonly System.Globalization.NumberFormatInfo KieuSo = new()
    {
        NumberGroupSeparator = ".",
        NumberDecimalSeparator = ","
    };

    private string Tien(decimal soTien) => soTien.ToString("#,##0", KieuSo) + "₫";
}
