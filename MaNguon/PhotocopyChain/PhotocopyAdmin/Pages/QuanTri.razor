@page "/quan-tri"
@attribute [Authorize(Roles = "SUPER_ADMIN,BRANCH_ADMIN")]
@inject HttpClient Http
@inject PhienDangNhap Phien
@inject PhamViChiNhanh PhamVi
@inject NavigationManager Nav

<PageTitle>Chi nhánh & máy in · PhotocopyChain</PageTitle>

<TieuDeTrang TieuDe="Chi nhánh & máy in" MoTa="Quản lý mạng lưới chi nhánh, thiết bị in ấn và vùng phục vụ toàn hệ thống" />

<div class="than-trang khoi-doc">
    @if (_loi != null && _suaChiNhanh == null && _themMay == null && _suaChiSo == null)
    {
        <div class="o-loi">
            @((MarkupString)Svg.ChamThan())
            <span>@_loi</span>
        </div>
    }
    @if (_thongBao != null)
    {
        <div class="o-thanh-cong the-rong">
            @((MarkupString)Svg.DauTich(16))
            <span>@_thongBao</span>
        </div>
    }

    @if (LaSuper())
    {
        <div class="xac-nhan-o">
            <button class="nut-chinh" @onclick="ThemChiNhanh">Thêm chi nhánh</button>
            <button class="nut-phu" @onclick="ThemMayIn">Thêm máy in</button>
        </div>
    }
    <button class="nut-phu" @onclick="TaiAsync" disabled="@_dangLuu">Làm mới danh sách</button>
    <HopThoaiQuanTri Mo="@(_suaChiNhanh != null)" TieuDe="@(_suaChiNhanh?.MaChiNhanh == 0 ? "Thêm chi nhánh mới" : "Sửa chi nhánh")" Loi="@_loi" DangLuu="@_dangLuu" Dong="DongChiNhanh" Rong="true">
        <NoiDung>
        <form id="qt-form-chi-nhanh" @onsubmit="LuuChiNhanhAsync" @onsubmit:preventDefault>
            <div class="ca-loc-luoi">
                <div class="truong">
                    <label class="nhan" for="qt-truong-1">Tên chi nhánh</label>
                    <input id="qt-truong-1" required maxlength="100" class="ca-o-loc" @bind="_suaChiNhanh.TenChiNhanh" />
                </div>
                <div class="truong">
                    <label class="nhan" for="qt-truong-2">Điện thoại hotline</label>
                    <input id="qt-truong-2" inputmode="numeric" pattern="0[0-9]{9}" title="10 chữ số, bắt đầu bằng 0" maxlength="10" class="ca-o-loc mono" @bind="_suaChiNhanh.SoDienThoai" />
                </div>
                <div class="truong">
                    <label class="nhan" for="qt-truong-3">Bán kính giao nhận tối đa (km)</label>
                    <input id="qt-truong-3" max="999.99" required class="ca-o-loc" type="number" step="0.01" min="0" @bind="_suaChiNhanh.BanKinhGiao" />
                </div>
                <div class="truong">
                    <label class="nhan" for="qt-truong-4">Trạng thái vận hành</label>
                    <select id="qt-truong-4" class="ca-o-loc" @bind="_suaChiNhanh.TrangThai">
                        <option value="HOAT_DONG">Đang hoạt động</option>
                        <option value="TAM_NGUNG">Tạm ngưng nhận đơn</option>
                    </select>
                </div>
            </div>
            <div class="ca-loc-luoi">
                <div class="truong"><label class="nhan" for="cn-mo">Giờ mở cửa</label><input id="cn-mo" type="time" required class="ca-o-loc" @bind="GioMo" /></div>
                <div class="truong"><label class="nhan" for="cn-dong">Giờ đóng cửa</label><input id="cn-dong" type="time" required class="ca-o-loc" @bind="GioDong" /></div>
                <div class="truong"><label class="nhan" for="cn-vi-do">Vĩ độ (nếu giao hàng)</label><input id="cn-vi-do" type="number" min="-90" max="90" step="0.000001" class="ca-o-loc" @bind="_suaChiNhanh.ViDo" /></div>
                <div class="truong"><label class="nhan" for="cn-kinh-do">Kinh độ (nếu giao hàng)</label><input id="cn-kinh-do" type="number" min="-180" max="180" step="0.000001" class="ca-o-loc" @bind="_suaChiNhanh.KinhDo" /></div>
            </div>
            <div class="truong" style="margin-top: 12px;">
                <label class="nhan" for="cn-dia-chi">Địa chỉ chi nhánh</label>
                <div class="o-nhap">
                    <input id="cn-dia-chi" required maxlength="255" @bind="_suaChiNhanh.DiaChi" />
                </div>
            </div>
        </form>
        </NoiDung>
        <Chan><button type="button" class="nut-phu" disabled="@_dangLuu" @onclick="DongChiNhanh">Hủy</button><button type="submit" form="qt-form-chi-nhanh" class="nut-chinh" disabled="@_dangLuu">@(_dangLuu ? "Đang lưu…" : "Lưu chi nhánh")</button></Chan>
    </HopThoaiQuanTri>

    <HopThoaiQuanTri Mo="@(_themMay != null)" TieuDe="Thêm máy in mới" Loi="@_loi" DangLuu="@_dangLuu" Dong="DongMayMoi" Rong="true">
        <NoiDung>
        <form id="qt-form-may" @onsubmit="LuuMayMoiAsync" @onsubmit:preventDefault>
            <div class="ca-loc-luoi">
                <div class="truong"><label class="nhan" for="may-chi-nhanh">Chi nhánh quản lý</label><select id="may-chi-nhanh" class="ca-o-loc" required @bind="_themMay.MaChiNhanh" disabled="@(PhamVi.MaChiNhanh != null)"><option value="0">Chọn chi nhánh</option>@foreach (var cn in _chiNhanh ?? new()) { <option value="@cn.MaChiNhanh">@cn.TenChiNhanh</option> }</select></div>
                <div class="truong"><label class="nhan" for="may-ten">Tên máy / model</label><input id="may-ten" class="ca-o-loc" maxlength="100" required @bind="_themMay.TenMay" /></div>
                <div class="truong"><label class="nhan" for="may-kho">Khổ giấy lớn nhất</label><select id="may-kho" class="ca-o-loc" @bind="_themMay.KhoGiay"><option value="A4">A4</option><option value="A3">A3 (hỗ trợ A4)</option></select></div>
                <div class="truong"><label class="nhan" for="may-toc-do">Tốc độ (trang/phút)</label><input id="may-toc-do" class="ca-o-loc" type="number" required min="1" max="1000" step="1" @bind="_themMay.TocDo" /></div>
                <div class="truong"><label class="nhan" for="may-counter">Counter ban đầu</label><input id="may-counter" class="ca-o-loc" type="number" required min="0" max="2147483647" step="1" @bind="_themMay.SoTrangDaIn" /></div>
                <div class="truong"><label class="nhan" for="may-trang-thai">Trạng thái thiết bị</label><select id="may-trang-thai" class="ca-o-loc" @bind="_themMay.TrangThai"><option value="HOAT_DONG">Hoạt động</option><option value="BAO_TRI">Bảo trì</option><option value="HONG">Hỏng</option></select></div>
                <label class="ca-chon"><input type="checkbox" @bind="_themMay.InMau" /> Hỗ trợ in màu</label>
                <label class="ca-chon"><input type="checkbox" @bind="_themMay.In2Mat" /> Hỗ trợ in hai mặt</label>
            </div>
            <p class="nv-phu">Đăng ký danh mục không tự kết nối thiết bị vật lý. Máy chỉ nhận job sau khi gateway/máy in ảo gửi heartbeat; thông số nên khớp model thực tế.</p>
        </form>
        </NoiDung>
        <Chan><button type="button" class="nut-phu" disabled="@_dangLuu" @onclick="DongMayMoi">Hủy</button><button type="submit" form="qt-form-may" class="nut-chinh" disabled="@_dangLuu">@(_dangLuu ? "Đang lưu…" : "Lưu máy in")</button></Chan>
    </HopThoaiQuanTri>
    <HopThoaiQuanTri Mo="@(_suaChiSo != null)" TieuDe="Sửa chỉ số trang in" MoTa="Nhập số counter trên thiết bị. Không thay đổi thông số in của các đơn cũ." Loi="@_loi" DangLuu="@_dangLuu" Dong="DongChiSo">
        <NoiDung><form id="qt-form-counter" @onsubmit="LuuChiSoAsync" @onsubmit:preventDefault><p><b>@_suaChiSo?.TenMay</b></p><label class="nhan" for="qt-counter">Chỉ số trang in</label><input id="qt-counter" required class="ca-o-loc mono" type="number" min="0" max="2147483647" step="1" @bind="_chiSoMoi" /></form></NoiDung>
        <Chan><button type="button" class="nut-phu" disabled="@_dangLuu" @onclick="DongChiSo">Hủy</button><button type="submit" form="qt-form-counter" class="nut-chinh" disabled="@_dangLuu">Lưu chỉ số</button></Chan>
    </HopThoaiQuanTri>
    <XacNhanThaoTac @ref="_xacNhan" />

    <div class="the the-bang">
        <div class="bang-tieu-de">
            <div>
                <h2>Mạng lưới chi nhánh & vùng phục vụ</h2>
                <p class="bang-mo-ta">Danh sách cơ sở và khu vực phục vụ trong chuỗi.</p>
            </div>
            <span class="bang-dem">@(_chiNhanh?.Count ?? 0) chi nhánh</span>
        </div>
        @if (_chiNhanh != null)
        {
            <div class="bang-cuon">
                <table role="table" class="bang bang-thao-tac-trai">
                    <thead>
                        <tr>
                            <th scope="col">Chi nhánh</th>
                            <th scope="col">Hotline liên hệ</th>
                            <th scope="col">Thời gian mở cửa</th>
                            <th scope="col">Bán kính giao hàng</th>
                            <th scope="col">Trạng thái hoạt động</th>
                            <th scope="col" class="cot-hanh-dong">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (ChiNhanhQuanTriDto c in _chiNhanh)
                        {
                            <tr>
                                <td data-nhan="Chi nhánh">
                                    <b>@c.TenChiNhanh</b>
                                    <div class="nv-phu">@c.DiaChi</div>
                                </td>
                                <td data-nhan="Hotline liên hệ">
                                    <span class="mono">@c.SoDienThoai</span>
                                </td>
                                <td data-nhan="Thời gian mở cửa">@Gio(c.GioMoCua) – @Gio(c.GioDongCua)</td>
                                <td class="mono" data-nhan="Bán kính giao hàng">
                                    <b>@c.BanKinhGiao</b> km
                                </td>
                                <td data-nhan="Trạng thái hoạt động">
                                    <span class="nhan-mau @(c.TrangThai == "HOAT_DONG" ? "nhan-xanh" : "nhan-xam")">
                                        @(c.TrangThai == "HOAT_DONG" ? "Đang hoạt động" : "Tạm ngưng")
                                    </span>
                                </td>
                                <td class="cot-hanh-dong" data-nhan="Thao tác">
                                    @if (LaSuper())
                                    {
                                        <button class="nut-nho" title="Sửa thông tin chi nhánh" @onclick="() => ChonChiNhanh(c)">Sửa chi nhánh</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="the the-bang">
        <div class="bang-tieu-de">
            <div>
                <h2>Hệ thống máy in</h2>
                <p class="bang-mo-ta">Thiết bị, chi nhánh quản lý và trạng thái máy in.</p>
            </div>
            <span class="bang-dem">@(_mayIn?.Count ?? 0) thiết bị</span>
        </div>
        @if (_mayIn != null)
        {
            <div class="bang-cuon">
                <table role="table" class="bang bang-thao-tac-trai">
                    <thead>
                        <tr>
                            <th scope="col">Tên thiết bị</th>
                            <th scope="col">Chi nhánh</th>
                            <th scope="col">Thông số kỹ thuật</th>
                            <th scope="col">Tốc độ in</th>
                            <th scope="col">Chỉ số trang in</th>
                            <th scope="col">Trạng thái máy</th>
                            <th scope="col" class="cot-hanh-dong">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (MayInQuanTriDto m in _mayIn)
                        {
                            <tr>
                                <td data-nhan="Tên thiết bị">
                                    <b>@m.TenMay</b>
                                </td>
                                <td data-nhan="Chi nhánh">@m.TenChiNhanh</td>
                                <td data-nhan="Thông số kỹ thuật">
                                    <div>@m.KhoGiay · @(m.InMau ? "In màu" : "Đen trắng") · @(m.In2Mat ? "2 mặt" : "1 mặt")</div>
                                </td>
                                <td data-nhan="Tốc độ in">
                                    <span class="mono"><b>@m.TocDo</b> trang/phút</span>
                                </td>
                                <td data-nhan="Chỉ số trang in">
                                    <b class="mono">@m.SoTrangDaIn</b>
                                    <button type="button" class="nut-nho" disabled="@_dangLuu" @onclick="() => MoChiSo(m)">Sửa chỉ số</button>
                                </td>
                                <td data-nhan="Trạng thái máy">
                                    <span class="nhan-mau @MauMay(m.TrangThai)">@m.TrangThai</span>
                                </td>
                                <td class="cot-hanh-dong" data-nhan="Thao tác">
                                    @if (m.TrangThai == "HOAT_DONG")
                                    {
                                        <button class="nut-nho nguy-hiem" title="Chuyển máy sang trạng thái bảo trì" @onclick="() => DoiTrangThaiMayAsync(m)">Bảo trì</button>
                                    }
                                    else
                                    {
                                        <button class="nut-nho" title="Mở lại máy để sẵn sàng in" @onclick="() => DoiTrangThaiMayAsync(m)">Mở lại</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>



</div>

@code {
    private List<ChiNhanhQuanTriDto> _chiNhanh;
    private List<MayInQuanTriDto> _mayIn;
    private ChiNhanhQuanTriDto _suaChiNhanh;
    private TaoMayInRequest _themMay;
    private bool _dangLuu;
    private MayInQuanTriDto _suaChiSo;
    private int _chiSoMoi;
    private XacNhanThaoTac _xacNhan;
    private void DongChiNhanh() { if (!_dangLuu) { _suaChiNhanh = null; _loi = null; } }
    private void DongMayMoi() { if (!_dangLuu) { _themMay = null; _loi = null; } }
    private void DongChiSo() { if (!_dangLuu) { _suaChiSo = null; _loi = null; } }
    private void MoChiSo(MayInQuanTriDto may) { if (_dangLuu) return; _suaChiSo = may; _chiSoMoi = may.SoTrangDaIn; _loi = _thongBao = null; }
    private async Task LuuChiSoAsync()
    {
        if (_dangLuu || _suaChiSo == null) return;
        // Không sửa trực tiếp dòng trong bảng trước khi API lưu thành công.
        await DoiMayAsync(_suaChiSo, _suaChiSo.TrangThai, _chiSoMoi);
        if (_loi == null) _suaChiSo = null;
    }
    private TimeOnly GioMo { get => TimeOnly.FromTimeSpan(_suaChiNhanh.GioMoCua); set => _suaChiNhanh.GioMoCua = value.ToTimeSpan(); }
    private TimeOnly GioDong { get => TimeOnly.FromTimeSpan(_suaChiNhanh.GioDongCua); set => _suaChiNhanh.GioDongCua = value.ToTimeSpan(); }
    private void ThemChiNhanh() { if (_dangLuu || !LaSuper()) return; _loi = _thongBao = null; _themMay = null; _suaChiNhanh = new() { GioMoCua = TimeSpan.FromHours(9), GioDongCua = TimeSpan.FromHours(21), BanKinhGiao = 10, TrangThai = "HOAT_DONG" }; }
    private void ThemMayIn() { if (_dangLuu || !LaSuper()) return; _loi = _thongBao = null; _suaChiNhanh = null; _themMay = new() { MaChiNhanh = PhamVi.MaChiNhanh ?? 0 }; }
    private string _loi;
    private string _thongBao;

    protected override async Task OnInitializedAsync()
    {
        if (Nav.Uri.Contains("da-them-chi-nhanh=1"))
            _thongBao = "Đã thêm chi nhánh, tạo giá mặc định và kho trống. Bạn có thể chọn cơ sở mới ở thanh phạm vi.";
        await TaiAsync();
    }

    private bool LaSuper() => Phien.NguoiDung?.TenVaiTro == "SUPER_ADMIN";

    private async Task TaiAsync()
    {
        _loi = null;
        try
        {
            _chiNhanh = await Http.GetFromJsonAsync<List<ChiNhanhQuanTriDto>>("api/quan-tri/chi-nhanh") ?? new();
            _mayIn = await Http.GetFromJsonAsync<List<MayInQuanTriDto>>("api/quan-tri/may-in") ?? new();
        }
        catch
        {
            _loi = "Không tải được dữ liệu quản trị.";
        }
    }

    private void ChonChiNhanh(ChiNhanhQuanTriDto c)
    {
        if (_dangLuu || !LaSuper()) return;
        _themMay = null;
        _loi = _thongBao = null;
        _suaChiNhanh = new()
        {
            MaChiNhanh = c.MaChiNhanh,
            TenChiNhanh = c.TenChiNhanh,
            DiaChi = c.DiaChi,
            SoDienThoai = c.SoDienThoai,
            ViDo = c.ViDo,
            KinhDo = c.KinhDo,
            GioMoCua = c.GioMoCua,
            GioDongCua = c.GioDongCua,
            BanKinhGiao = c.BanKinhGiao,
            TrangThai = c.TrangThai
        };
    }

    private async Task LuuChiNhanhAsync()
    {
        if (_dangLuu || _suaChiNhanh == null) return;
        _loi = QuyTacNhap.LayLoi(_suaChiNhanh);
        if (_loi != null) return;
        _dangLuu = true;
        _thongBao = null;
        try
        {
            bool themMoi = _suaChiNhanh.MaChiNhanh == 0;
            var r = themMoi ? await Http.PostAsJsonAsync("api/quan-tri/chi-nhanh", _suaChiNhanh)
                : await Http.PutAsJsonAsync("api/quan-tri/chi-nhanh/" + _suaChiNhanh.MaChiNhanh, _suaChiNhanh);
            if (!r.IsSuccessStatusCode) { _loi = await DocLoiApi.TuPhanHoiAsync(r, "Không lưu được chi nhánh."); return; }
            if (themMoi)
            {
                // Nạp lại shell để danh sách phạm vi có cơ sở mới, kể cả khi trước đó đang xem cơ sở khác.
                await PhamVi.ChonAsync(null);
                Nav.NavigateTo("quan-tri?da-them-chi-nhanh=1", forceLoad: true);
                return;
            }
            _thongBao = "Đã cập nhật chi nhánh.";
            _suaChiNhanh = null;
            await TaiAsync();
        }
        catch (HttpRequestException) { _loi = "Mất kết nối API. Làm mới danh sách trước khi thử lại để tránh tạo trùng."; }
        finally { _dangLuu = false; }
    }

    private async Task LuuMayMoiAsync()
    {
        if (_dangLuu || _themMay == null) return;
        _loi = QuyTacNhap.LayLoi(_themMay);
        if (_loi != null) return;
        _dangLuu = true;
        _thongBao = null;
        try
        {
            var r = await Http.PostAsJsonAsync("api/quan-tri/may-in", _themMay);
            if (!r.IsSuccessStatusCode) { _loi = await DocLoiApi.TuPhanHoiAsync(r, "Không thêm được máy in."); return; }
            _themMay = null;
            _thongBao = "Đã đăng ký máy in. Kết nối máy in ảo hoặc gateway để thiết bị nhận lệnh.";
            await TaiAsync();
        }
        catch (HttpRequestException) { _loi = "Mất kết nối API. Làm mới danh sách trước khi thử lại để tránh tạo trùng."; }
        finally { _dangLuu = false; }
    }

    private async Task DoiMayAsync(MayInQuanTriDto m, string tt, int? chiSo = null)
    {
        if (_dangLuu) return;
        var req = new CapNhatMayInRequest { TrangThai = tt, SoTrangDaIn = chiSo ?? m.SoTrangDaIn };
        _loi = QuyTacNhap.LayLoi(req);
        if (_loi != null) return;
        _dangLuu = true; _thongBao = null;
        try
        {
            using var r = await Http.PutAsJsonAsync("api/quan-tri/may-in/" + m.MaMayIn, req);
            if (!r.IsSuccessStatusCode) { _loi = await DocLoiApi.TuPhanHoiAsync(r, "Không cập nhật được máy in."); return; }
            _thongBao = "Đã cập nhật máy in.";
            await TaiAsync();
        }
        catch (HttpRequestException) { _loi = "Mất kết nối API. Làm mới danh sách để kiểm tra kết quả."; }
        finally { _dangLuu = false; }
    }

    private async Task DoiTrangThaiMayAsync(MayInQuanTriDto m)
    {
        if (_dangLuu || !await _xacNhan.HoiAsync("Đổi trạng thái máy “" + m.TenMay + "”? Máy bảo trì sẽ không nhận việc in mới.", "Trạng thái máy in", m.TrangThai == "HOAT_DONG" ? "Bảo trì" : "Mở lại")) return;
        await DoiMayAsync(m, m.TrangThai == "HOAT_DONG" ? "BAO_TRI" : "HOAT_DONG");
    }

    private string MauMay(string s) => s == "HOAT_DONG"
        ? "nhan-xanh"
        : s == "HONG" ? "nhan-do" : "nhan-cam";

    private string Gio(TimeSpan gio) => gio.ToString(@"hh\:mm");
}
