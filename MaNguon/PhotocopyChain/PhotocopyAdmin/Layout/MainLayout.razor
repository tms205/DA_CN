@inherits LayoutComponentBase
@inject PhienDangNhap Phien
@inject PhamViChiNhanh PhamVi
@inject HttpClient Http
@inject NavigationManager Nav
@inject ThongBaoPheDuyet ThongBao
@inject IJSRuntime JS
@implements IDisposable

@* AppShell dùng chung: sidebar desktop, sidebar thu gọn và drawer trên màn hình nhỏ. *@
<div class="@LopKhung">
    <button type="button" class="man-che" aria-label="Đóng menu điều hướng" @onclick="DongMenu"></button>

    <aside id="menu-chinh" class="thanh-ben" aria-label="Điều hướng chính">
        <div class="tb-logo">
            <div class="tb-logo-icon">@((MarkupString)Svg.MayIn(19))</div>
            <div class="tb-logo-chu">
                <div class="tb-logo-ten">PhotocopyChain</div>
                <div class="tb-logo-phu">Quản trị chuỗi chi nhánh</div>
            </div>
            <button type="button" class="tb-dong-menu" title="Đóng menu" aria-label="Đóng menu" @onclick="DongMenu">×</button>
        </div>

        <div class="tb-chi-nhanh">
            <span class="tb-trang-thai" aria-hidden="true"></span>
            <div class="tb-chi-nhanh-chu">
                <div class="tb-chi-nhanh-ten">@TenPhamVi</div>
                <div class="tb-chi-nhanh-dc">@DiaChiPhamVi</div>
            </div>
        </div>

        @* Menu: mỗi mục chỉ hiện với vai trò dùng được nó.
           Ẩn menu chỉ để gọn giao diện — API vẫn tự kiểm quyền trên từng request. *@
        <nav class="tb-menu">
            @if (LaQuanLy())
            {
                <section class="tb-nhom" aria-labelledby="nhom-bao-cao">
                    <button type="button" id="nhom-bao-cao" class="tb-nhom-tieu-de" aria-expanded="@(_cacNhomDangMo.Contains("bao-cao") ? "true" : "false")" aria-controls="menu-bao-cao" @onclick='() => DoiNhom("bao-cao")'>@((MarkupString)Svg.BangDieuKhien(20)) <span>Dashboard</span><span class="tb-nhom-mui-ten" aria-hidden="true"></span></button>
                    <div id="menu-bao-cao" class="tb-nhom-noi-dung @(_cacNhomDangMo.Contains("bao-cao") ? "" : "dong")">
                        <NavLink class="tb-muc" href="tong-quan" title="Tổng quan" @onclick="DongMenu">@((MarkupString)Svg.DongHoDo()) <span>Tổng quan</span></NavLink>
                        <NavLink class="tb-muc" href="bao-cao" title="Báo cáo doanh thu" @onclick="DongMenu">@((MarkupString)Svg.BieuDoCot(18)) <span>Báo cáo doanh thu</span></NavLink>
                    </div>
                </section>
            }
            <section class="tb-nhom" aria-labelledby="nhom-van-hanh">
                <button type="button" id="nhom-van-hanh" class="tb-nhom-tieu-de"
                        aria-expanded="@(_cacNhomDangMo.Contains("van-hanh") ? "true" : "false")" aria-controls="menu-van-hanh"
                        @onclick='() => DoiNhom("van-hanh")'>
                    @((MarkupString)Svg.QuyTrinh(20))
                    <span>Vận hành</span>
                    <span class="tb-nhom-mui-ten" aria-hidden="true"></span>
                </button>
                <div id="menu-van-hanh" class="tb-nhom-noi-dung @(_cacNhomDangMo.Contains("van-hanh") ? "" : "dong")">
                    <NavLink class="tb-muc" href="" Match="NavLinkMatch.All" title="Hàng đợi đơn hàng" @onclick="DongMenu">@((MarkupString)Svg.DanhSach(18)) <span>Hàng đợi đơn</span></NavLink>
                    @if (VaiTroLa("BRANCH_ADMIN") || VaiTroLa("STAFF") || CeoDangXemChiNhanh())
                    {
                        <NavLink class="tb-muc" href="lap-don-tai-quay" title="Lập đơn tại quầy" @onclick="DongMenu">@((MarkupString)Svg.HoaDon(18)) <span>Lập đơn tại quầy</span></NavLink>
                        <NavLink class="tb-muc" href="ban-giao" title="Bàn giao tại quầy" @onclick="DongMenu">@((MarkupString)Svg.CapTap(18)) <span>Bàn giao tại quầy</span></NavLink>
                    }
                    <NavLink class="tb-muc" href="kho-file" title="Kho file in" @onclick="DongMenu">@((MarkupString)Svg.TaiLieu(18)) <span>Kho file in</span></NavLink>
                    <NavLink class="tb-muc" href="giao-hang" title="Giao hàng nội bộ" @onclick="DongMenu">@((MarkupString)Svg.XeGiao(18)) <span>Giao hàng nội bộ</span></NavLink>
                </div>
            </section>

            <section class="tb-nhom" aria-labelledby="nhom-ca-tien">
                <button type="button" id="nhom-ca-tien" class="tb-nhom-tieu-de"
                        aria-expanded="@(_cacNhomDangMo.Contains("ca-tien") ? "true" : "false")" aria-controls="menu-ca-tien"
                        @onclick='() => DoiNhom("ca-tien")'>
                    @((MarkupString)Svg.TienMat(20))
                    <span>Ca &amp; tiền</span>
                    <span class="tb-nhom-mui-ten" aria-hidden="true"></span>
                </button>
                <div id="menu-ca-tien" class="tb-nhom-noi-dung @(_cacNhomDangMo.Contains("ca-tien") ? "" : "dong")">
                    <NavLink class="tb-muc" href="ca-lam-viec" title="Ca làm việc & két tiền" @onclick="DongMenu">@((MarkupString)Svg.ViTien()) <span>Ca làm việc &amp; két tiền</span></NavLink>
                    @if (VaiTroLa("SUPER_ADMIN") || VaiTroLa("BRANCH_ADMIN") || VaiTroLa("STAFF"))
                    {
                        <NavLink class="tb-muc" href="don-hang-trong-ca" title="Lịch sử đơn theo ca" @onclick="DongMenu">@((MarkupString)Svg.LichSu()) <span>Lịch sử đơn theo ca</span></NavLink>
                    }
                </div>
            </section>

            <section class="tb-nhom" aria-labelledby="nhom-quan-ly">
                <button type="button" id="nhom-quan-ly" class="tb-nhom-tieu-de"
                        aria-expanded="@(_cacNhomDangMo.Contains("quan-ly") ? "true" : "false")" aria-controls="menu-quan-ly"
                        @onclick='() => DoiNhom("quan-ly")'>
                    @((MarkupString)Svg.SoDoQuanLy(20))
                    <span>Quản lý</span>
                    <span class="tb-nhom-mui-ten" aria-hidden="true"></span>
                </button>
                <div id="menu-quan-ly" class="tb-nhom-noi-dung @(_cacNhomDangMo.Contains("quan-ly") ? "" : "dong")">
                    @if (LaQuanLy())
                    {
                        <NavLink class="tb-muc" href="kho-vat-tu" title="Kho vật tư" @onclick="DongMenu">@((MarkupString)Svg.LopKho(18)) <span>Kho vật tư</span></NavLink>
                    }
                    @if (LaQuanLy())
                    {
                        <NavLink class="tb-muc" href="dich-vu" title="Dịch vụ" @onclick="DongMenu">@((MarkupString)Svg.DichVu(18)) <span>Dịch vụ</span></NavLink>
                        <NavLink class="tb-muc" href="nhan-vien" title="Nhân viên" @onclick="DongMenu">@((MarkupString)Svg.NguoiDung(18)) <span>Nhân viên</span></NavLink>
                        <NavLink class="tb-muc" href="danh-gia" title="Đánh giá khách hàng" @onclick="DongMenu">@((MarkupString)Svg.NgoiSao()) <span>Đánh giá khách hàng</span></NavLink>
                    }
                    @if (VaiTroLa("SUPER_ADMIN"))
                    {
                        <NavLink class="tb-muc" href="khach-hang" title="Khách hàng" @onclick="DongMenu">@((MarkupString)Svg.NguoiMot(18)) <span>Khách hàng</span></NavLink>
                        <NavLink class="tb-muc" href="phe-duyet" title="Phê duyệt phiếu nhập và hoàn tiền" @onclick="DongMenu">@((MarkupString)Svg.DuyetHoSo(18)) <span>Phê duyệt</span>@if (ThongBao.SoCho != 0) { <span class="tb-badge" aria-label="@(ThongBao.SoCho == null ? "Số yêu cầu chờ duyệt chưa tải được" : $"{ThongBao.SoCho} yêu cầu chờ duyệt")">@(ThongBao.SoCho?.ToString() ?? "?")</span> }</NavLink>
                    }
                </div>
            </section>
            <section class="tb-nhom" aria-labelledby="nhom-cau-hinh">
                <button type="button" id="nhom-cau-hinh" class="tb-nhom-tieu-de" aria-expanded="@(_cacNhomDangMo.Contains("cau-hinh") ? "true" : "false")" aria-controls="menu-cau-hinh" @onclick='() => DoiNhom("cau-hinh")'>@((MarkupString)Svg.CaiDat(20)) <span>Cấu hình</span><span class="tb-nhom-mui-ten" aria-hidden="true"></span></button>
                <div id="menu-cau-hinh" class="tb-nhom-noi-dung @(_cacNhomDangMo.Contains("cau-hinh") ? "" : "dong")">
                    <NavLink class="tb-muc" href="bang-gia" title="Bảng giá in ấn" @onclick="DongMenu">@((MarkupString)Svg.NhanGia()) <span>Bảng giá in ấn</span></NavLink>
                    @if (VaiTroLa("SUPER_ADMIN")) { <NavLink class="tb-muc" href="khuyen-mai" title="Quản lý khuyến mãi" @onclick="DongMenu">@((MarkupString)Svg.VeKhuyenMai()) <span>Khuyến mãi</span></NavLink> }
                    @if (LaQuanLy()) { <NavLink class="tb-muc" href="quan-tri" title="Chi nhánh & máy in" @onclick="DongMenu">@((MarkupString)Svg.CuaHang(18)) <span>Chi nhánh &amp; máy in</span></NavLink> }
                </div>
            </section>
        </nav>

        <div class="tb-gian"></div>

        <div class="tb-nguoi-dung">
            @* F-03: bấm vào tên / ảnh đại diện để mở Thông tin cá nhân *@
            <NavLink class="tb-nd-lien-ket" href="thong-tin-ca-nhan" title="Thông tin cá nhân & đổi mật khẩu">
                <div class="tb-avatar">@VietTat(ND?.HoTen)</div>
                <div class="tb-nd-chu">
                    <div class="tb-nd-ten">@ND?.HoTen</div>
                    <div class="tb-nd-vai-tro">@(ND == null ? "" : VaiTro.TenHienThi(ND.TenVaiTro)) · Hồ sơ</div>
                </div>
            </NavLink>
            <button class="tb-dang-xuat" title="Đăng xuất" @onclick="DangXuat">@((MarkupString)Svg.DangXuat())</button>
        </div>
    </aside>

    <section class="vung-lam-viec">
        <header class="thanh-tren" role="banner" aria-label="Thanh điều hướng">
            <div class="tt-trai">
                <button type="button" class="tt-menu tt-menu-desktop" title="Thu gọn hoặc mở rộng menu"
                        aria-label="Thu gọn hoặc mở rộng menu" aria-controls="menu-chinh"
                        aria-expanded="@(_menuThuGon ? "false" : "true")" @onclick="ThuGonMenu">
                    @((MarkupString)Svg.DanhSach(20))
                </button>
                <button type="button" class="tt-menu tt-menu-mobile" aria-label="Mở menu điều hướng"
                        aria-controls="menu-chinh" aria-expanded="@(_menuMo ? "true" : "false")" @onclick="MoDongMenu">
                    @((MarkupString)Svg.DanhSach(20))
                </button>
                <div class="tt-ngu-canh">
                    <span>PhotocopyChain · @TrangDangMo.Nhom</span>
                    <strong>@TrangDangMo.Ten</strong>
                </div>
            </div>

            <div class="tt-pham-vi">
                <span class="tt-pham-vi-icon">@((MarkupString)Svg.CuaHang(16))</span>
                @if (VaiTroLa(VaiTro.SuperAdmin))
                {
                    <select value="@GiaTriPhamVi" @onchange="DoiPhamViAsync" aria-label="Chọn phạm vi chi nhánh">
                        <option value="">Tổng quan tất cả chi nhánh</option>
                        @foreach (ChiNhanhDto chiNhanh in _dsChiNhanh)
                        {
                            <option value="@chiNhanh.MaChiNhanh">@chiNhanh.TenChiNhanh</option>
                        }
                    </select>
                }
                else
                {
                    <span class="tt-pham-vi-ten">@TenPhamVi</span>
                }
            </div>
        </header>

        <main class="noi-dung">
            <div class="noi-dung-trang">@Body</div>
        </main>
        <footer class="chan-trang" role="contentinfo" aria-label="Thông tin hệ thống">
            <div class="ct-thuong-hieu">
                <div class="ct-dong-thuong-hieu">
                    <strong>PhotocopyChain</strong>
                    <small class="ct-ban-quyen">© @DateTime.Now.Year</small>
                </div>
                <span class="ct-slogan">In rõ nét — Nhận đúng hẹn.</span>
            </div>
            <address class="ct-lien-he" aria-label="Thông tin liên hệ">
                <a class="ct-muc-lien-he" href="@("https://mail.google.com/mail/?view=cm&fs=1&to=manh27062005%40gmail.com")" target="_blank" rel="noopener noreferrer" aria-label="Email liên hệ: manh27062005@gmail.com">
                    <span class="ct-lien-he-icon" aria-hidden="true">@((MarkupString)Svg.Thu(18))</span>
                    <span class="ct-lien-he-chu"><span class="ct-nhan">Email liên hệ</span><span class="ct-gia-tri">manh27062005&#64;<wbr />gmail.com</span></span>
                </a>
                <button type="button" class="ct-muc-lien-he" aria-label="Điện thoại: 0769479813" aria-haspopup="dialog" @onclick="MoLienHeAsync">
                    <span class="ct-lien-he-icon" aria-hidden="true">@((MarkupString)Svg.DienThoai(18))</span>
                    <span class="ct-lien-he-chu"><span class="ct-nhan">Điện thoại</span><span class="ct-gia-tri">0769479813</span></span>
                </button>
            </address>
        </footer>
    </section>
</div>
<dialog class="ct-hop-thoai" @ref="_hopLienHe" aria-labelledby="tieu-de-lien-he">
    <form method="dialog" class="ca-dau">
        <h2 id="tieu-de-lien-he">Liên hệ qua điện thoại</h2>
        <button class="nut-dong" aria-label="Đóng liên hệ">×</button>
    </form>
    <p>Trên điện thoại, chọn gọi để mở ứng dụng điện thoại. Máy tính cần có ứng dụng hỗ trợ cuộc gọi; bạn cũng có thể sao chép số bên dưới.</p>
    <label class="nhan" for="so-lien-he">Số điện thoại</label>
    <input id="so-lien-he" class="ca-o-loc mono" value="0769479813" readonly autofocus />
    <div class="xac-nhan-o">
        <a class="nut-chinh" href="tel:0769479813">Gọi bằng ứng dụng</a>
        <button type="button" class="nut-phu" @onclick="SaoChepSoAsync">Sao chép số</button>
    </div>
    <p role="status">@_ketQuaSaoChep</p>
</dialog>

@code {
    // Nhận trạng thái đăng nhập từ Blazor: sửa hồ sơ xong thì layout tự vẽ lại → tên ở sidebar đổi ngay
    [CascadingParameter] private Task<AuthenticationState> TrangThaiDangNhap { get; set; }

    // Người đang đăng nhập
    private NguoiDungDto ND => Phien.NguoiDung;
    private List<ChiNhanhDto> _dsChiNhanh = new();
    private ElementReference _hopLienHe;
    private string _ketQuaSaoChep;
    private bool _menuMo;
    private bool _menuThuGon;
    private HashSet<string> _cacNhomDangMo = new();

    private string GiaTriPhamVi => PhamVi.MaChiNhanh?.ToString() ?? "";

    // Chỉ là nhãn giao diện; quyền truy cập vẫn do trang và API kiểm tra.
    private (string Nhom, string Ten) TrangDangMo
    {
        get
        {
            string trang = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Trim('/');
            return trang switch {
                "tong-quan" => ("Dashboard", "Tổng quan"),
                "bao-cao" => ("Dashboard", "Báo cáo doanh thu"),
                "" => ("Vận hành", "Hàng đợi đơn hàng"),
                "lap-don-tai-quay" => ("Vận hành", "Lập đơn tại quầy"),
                "ban-giao" => ("Vận hành", "Bàn giao tại quầy"),
                "giao-hang" => ("Vận hành", "Giao hàng nội bộ"),
                "kho-file" => ("Vận hành", "Kho file in"),
                "ca-lam-viec" => ("Ca & tiền", "Ca làm việc & két tiền"),
                "don-hang-trong-ca" => ("Ca & tiền", "Lịch sử đơn theo ca"),
                "kho-vat-tu" => ("Quản lý", "Kho vật tư"),
                "nhan-vien" => ("Quản lý", "Nhân viên"),
                "khach-hang" => ("Quản lý", "Khách hàng"),
                "dich-vu" => ("Quản lý", "Dịch vụ"),
                "danh-gia" => ("Quản lý", "Đánh giá khách hàng"),
                "phe-duyet" => ("Quản lý", "Phê duyệt"),
                "bang-gia" => ("Cấu hình", "Bảng giá in ấn"),
                "khuyen-mai" => ("Cấu hình", "Khuyến mãi"),
                "quan-tri" => ("Cấu hình", "Chi nhánh & máy in"),
                "thong-tin-ca-nhan" => ("Tài khoản", "Thông tin cá nhân"),
                _ => ("PhotocopyChain", "Không gian quản trị")
            };
        }
    }

    private string LopKhung => $"khung{(_menuMo ? " menu-dang-mo" : "")}{(_menuThuGon ? " menu-thu-gon" : "")}";

    private ChiNhanhDto ChiNhanhDangChon => _dsChiNhanh
        .FirstOrDefault(x => x.MaChiNhanh == PhamVi.MaChiNhanh);

    private string TenPhamVi => VaiTroLa(VaiTro.SuperAdmin)
        ? ChiNhanhDangChon?.TenChiNhanh ?? "Tổng quan tất cả"
        : ND?.TenChiNhanh ?? "Toàn chuỗi";

    private string DiaChiPhamVi => VaiTroLa(VaiTro.SuperAdmin)
        ? ChiNhanhDangChon?.DiaChi ?? "Dữ liệu toàn hệ thống"
        : ND?.DiaChiChiNhanh ?? "Tất cả chi nhánh";

    protected override async Task OnInitializedAsync()
    {
        MoNhomCuaTrang();
        await PhamVi.KhoiTaoAsync();
        await TrangThaiDangNhap;
        Nav.LocationChanged += DoiTrang;
        if (!VaiTroLa(VaiTro.SuperAdmin)) return;

        ThongBao.ThayDoi += VeBadge;
        await ThongBao.TaiAsync();

        try
        {
            _dsChiNhanh = await Http.GetFromJsonAsync<List<ChiNhanhDto>>("api/danh-muc/chi-nhanh") ?? new();
            if (PhamVi.MaChiNhanh != null && ChiNhanhDangChon == null)
                await PhamVi.ChonAsync(null);
        }
        catch
        {
            _dsChiNhanh = new();
        }
    }

    private bool VaiTroLa(string vaiTro)
    {
        return ND != null && ND.TenVaiTro == vaiTro;
    }

    // Super Admin hoặc Quản lý chi nhánh
    private bool LaQuanLy()
    {
        return VaiTroLa("SUPER_ADMIN") || VaiTroLa("BRANCH_ADMIN");
    }

    private bool CeoDangXemChiNhanh()
    {
        return VaiTroLa(VaiTro.SuperAdmin) && PhamVi.MaChiNhanh != null;
    }

    private async Task DoiPhamViAsync(ChangeEventArgs e)
    {
        int? maChiNhanh = int.TryParse(e.Value?.ToString(), out int ma) ? ma : null;
        await PhamVi.ChonAsync(maChiNhanh);
        DongMenu();
        Nav.NavigateTo(Nav.Uri, forceLoad: true);
    }

    private void MoDongMenu()
    {
        _menuMo = !_menuMo;
    }

    private void ThuGonMenu()
    {
        _menuThuGon = !_menuThuGon;
        if (!_menuThuGon) MoNhomCuaTrang();
    }

    private void DoiNhom(string nhom)
    {
        // Mỗi nhóm mở/đóng riêng, không ảnh hưởng đến các nhóm còn lại.
        if (!_cacNhomDangMo.Remove(nhom)) _cacNhomDangMo.Add(nhom);
    }

    // Mở đúng nhóm khi truy cập trực tiếp hoặc mở rộng sidebar từ chế độ biểu tượng.
    private void MoNhomCuaTrang()
    {
        string duongDan = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Trim('/');
        if (duongDan == "ca-lam-viec" || duongDan == "don-hang-trong-ca")
            _cacNhomDangMo.Add("ca-tien");
        else if (duongDan == "tong-quan" || duongDan == "bao-cao")
            _cacNhomDangMo.Add("bao-cao");
        else if (duongDan == "bang-gia" || duongDan == "khuyen-mai" || duongDan == "quan-tri")
            _cacNhomDangMo.Add("cau-hinh");
        else if (duongDan == "kho-vat-tu" || duongDan == "nhan-vien" || duongDan == "danh-gia" || duongDan == "phe-duyet" || duongDan == "khach-hang" || duongDan == "dich-vu")
            _cacNhomDangMo.Add("quan-ly");
        else
            _cacNhomDangMo.Add("van-hanh");
    }

    private void DongMenu()
    {
        _menuMo = false;
    }

    // "Trần Thị Quản" → "TQ" (chữ trong ô ảnh đại diện)
    private string VietTat(string hoTen)
    {
        if (string.IsNullOrWhiteSpace(hoTen)) return "?";
        string[] tu = hoTen.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (tu.Length == 1) return tu[0].Substring(0, 1).ToUpper();
        return (tu[tu.Length - 2].Substring(0, 1) + tu[tu.Length - 1].Substring(0, 1)).ToUpper();
    }

    private async Task DangXuat()
    {
        await Phien.DangXuat();
        Nav.NavigateTo("dang-nhap", replace: true);
    }

    private async Task MoLienHeAsync()
    {
        _ketQuaSaoChep = null;
        await JS.InvokeVoidAsync("moLienHeFooter", _hopLienHe);
    }

    private async Task SaoChepSoAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", "0769479813");
            _ketQuaSaoChep = "Đã sao chép số điện thoại.";
        }
        catch (JSException)
        {
            _ketQuaSaoChep = "Trình duyệt không cho sao chép. Hãy chọn số điện thoại và sao chép thủ công.";
        }
    }

    private void VeBadge() => _ = InvokeAsync(StateHasChanged);
    private void DoiTrang(object sender, LocationChangedEventArgs e)
    {
        MoNhomCuaTrang();
        _ = InvokeAsync(StateHasChanged);
        if (VaiTroLa(VaiTro.SuperAdmin)) _ = ThongBao.TaiAsync();
    }
    public void Dispose()
    {
        ThongBao.ThayDoi -= VeBadge;
        Nav.LocationChanged -= DoiTrang;
    }
}
