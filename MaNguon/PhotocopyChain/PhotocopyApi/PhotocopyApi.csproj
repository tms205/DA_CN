<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>9cf3cae1-f382-4c95-b8ed-9d897c9f996d</UserSecretsId>
    <!-- API chỉ chạy trên Windows (dùng Microsoft Office để đổi Word/Excel sang PDF) nên tắt cảnh báo "chỉ hỗ trợ Windows" -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="Dapper" Version="2.1.86" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.25" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.3" />
    <PackageReference Include="payOS" Version="2.1.0" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="PDFtoImage" Version="5.4.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="System.Drawing.Common" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PhotocopyShared\PhotocopyShared.csproj" />
    <Compile Include="..\CauHinh\DocFileEnv.cs" Link="CauHinh\DocFileEnv.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Chỉ đóng gói tài nguyên đang dùng; bản Word nguồn giữ trong repo. -->
    <None Update="TaiNguyen\MauDon\catalog.json;TaiNguyen\MauDon\*.pdf;TaiNguyen\MauDon\XemTruoc\*.png"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
